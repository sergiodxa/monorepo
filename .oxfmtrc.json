{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": ["apps/auth-saas/src/app/controllers/dashboard/tenants/branding.ts"],
	"useTabs": true,
	"experimentalSortPackageJson": true,
	"experimentalSortImports": {
		"groups": [
			["value-builtin"],
			["type-external"],
			["value-external"],
			["type-internal"],
			["value-internal"],
			["type-parent"],
			["value-parent"],
			["type-sibling"],
			["value-sibling"],
			["type-index"],
			["value-index"],
			["side_effect"]
		]
	},
	"overrides": [
		{
			"files": ["apps/auth/**/*.{js,jsx,ts,tsx}"],
			"options": {
				"experimentalTailwindcss": {
					"stylesheet": "./apps/auth/app/styles.css"
				}
			}
		}
	]
}
