{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": [],
	"useTabs": true,
	"experimentalSortPackageJson": true,
	"experimentalSortImports": {
		"groups": [
			["builtin"],
			["type-external"],
			["external"],
			["type-internal"],
			["internal"],
			["type-parent"],
			["parent"],
			["type-sibling"],
			["sibling"],
			["type-index"],
			["index"],
			["side-effect"]
		]
	},
	"overrides": [
		{
			"files": ["apps/auth/**/*.{js,jsx,ts,tsx}"],
			"options": {
				"experimentalTailwindcss": {
					"stylesheet": "./apps/auth/app/styles.css"
				}
			}
		},
		{
			"files": ["apps/blog/**/*.{js,jsx,ts,tsx}"],
			"options": {
				"experimentalTailwindcss": {
					"stylesheet": "./apps/blog/app/styles.css",
					"functions": ["cn"]
				}
			}
		},
		{
			"files": ["apps/books/**/*.{js,jsx,ts,tsx}"],
			"options": {
				"experimentalTailwindcss": {
					"stylesheet": "./apps/books/app/app.css",
					"functions": ["cn"]
				}
			}
		},
		{
			"files": ["apps/uptime/**/*.{js,jsx,ts,tsx}"],
			"options": {
				"experimentalTailwindcss": {
					"stylesheet": "./apps/uptime/app/assets/styles.css",
					"functions": ["cn"]
				}
			}
		}
	]
}
