{
	"name": "monorepo",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --deny-warnings --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"@total-typescript/tsconfig": "^1.0.4",
		"oxfmt": "^0.36.0",
		"oxlint": "^1.51.0",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@types/bcryptjs": "^3.0.0",
		"@types/bun": "^1.3.10"
	}
}
