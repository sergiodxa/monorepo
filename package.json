{
	"name": "monorepo",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"format": "bun ./node_modules/oxfmt/dist/cli.js --check",
		"format:fix": "bun ./node_modules/oxfmt/dist/cli.js",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --deny-warnings --fix",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"@total-typescript/tsconfig": "^1.0.4",
		"oxfmt": "^0.43.0",
		"oxlint": "^1.58.0",
		"typescript": "^6.0.2"
	},
	"devDependencies": {
		"@types/bcryptjs": "^3.0.0",
		"@types/bun": "^1.3.11"
	}
}
