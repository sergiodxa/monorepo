{
	"name": "monorepo",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"check": "vp run check:all",
		"check:fix": "vp check --fix",
		"doctor": "bun scripts/doctor-apps.ts",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath scripts/git-hooks && git config commit.cleanup scissors || true",
		"release": "bun scripts/release/main.ts",
		"release:bootstrap": "bun scripts/release/bootstrap.ts",
		"sdxc:generate": "bun scripts/sdxc/generate.ts",
		"kit:registry": "bun scripts/sdxc/kit-registry.ts",
		"test": "vp test run",
		"typecheck": "vp check --no-fmt --no-lint",
		"upgrade": "bun scripts/upgrade-dependencies.ts",
		"upgrade:apps": "bun scripts/upgrade-dependencies.ts --workspace apps",
		"upgrade:apps:dry-run": "bun scripts/upgrade-dependencies.ts --dry-run --workspace apps",
		"upgrade:dry-run": "bun scripts/upgrade-dependencies.ts --dry-run",
		"upgrade:packages": "bun scripts/upgrade-dependencies.ts --workspace packages",
		"upgrade:packages:dry-run": "bun scripts/upgrade-dependencies.ts --dry-run --workspace packages"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.21.3",
		"@sdxc/codemod": "workspace:*",
		"@sdxc/jsonl": "workspace:*",
		"@sdxc/markdown": "workspace:*",
		"@sdxc/result": "workspace:*",
		"@sdxc/semver": "workspace:*",
		"@sdxc/spec": "workspace:*",
		"@total-typescript/ts-reset": "^0.6.1",
		"@total-typescript/tsconfig": "^1.0.4",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"happy-dom": "^20.14.5",
		"msw": "^2.15.0",
		"oxc-parser": "^0.154.0",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
		"vite-plus": "0.3.3",
		"vitest": "4.1.11"
	},
	"overrides": {
		"miniflare": "5.20260926.0-alpha"
	},
	"devEngines": {
		"packageManager": [
			{
				"name": "bun",
				"version": "1.4.2",
				"onFail": "download"
			},
			{
				"name": "npm"
			}
		]
	}
}
