{
	"extends": "../../tsconfig.json",
	"include": ["src/**/*"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "remix/ui",
		"types": ["@total-typescript/ts-reset", "@cloudflare/workers-types", "@types/bun"],
		// The package uses relative imports only (no ~/ alias): a consumer resolves
		// these .ts sources against its own tsconfig, so a path alias would not apply there.
		"ignoreDeprecations": "6.0",
		// `remix/auth-middleware` (beta) ships its `dist` as TypeScript source that
		// imports sibling modules with explicit `.ts` extensions; allow it (safe under
		// the inherited `noEmit`). Consumers compiling these sources need it too.
		"allowImportingTsExtensions": true
	}
}
