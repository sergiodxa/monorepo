{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sdxc.dev/schemas/health.json",
	"type": "object",
	"properties": {
		"status": {
			"type": "string",
			"pattern": "^([Pp][Aa][Ss][Ss]|[Oo][Kk]|[Uu][Pp]|[Ww][Aa][Rr][Nn]|[Ff][Aa][Ii][Ll]|[Ee][Rr][Rr][Oo][Rr]|[Dd][Oo][Ww][Nn])$",
			"description": "pass, warn or fail, in any case; ok and up mean pass, error and down fail"
		},
		"version": {
			"type": "string"
		},
		"releaseId": {
			"type": "string"
		},
		"serviceId": {
			"type": "string"
		},
		"description": {
			"type": "string"
		},
		"notes": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"output": {
			"type": "string"
		},
		"checks": {
			"type": "object",
			"additionalProperties": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"componentId": {
							"type": "string"
						},
						"componentType": {
							"type": "string"
						},
						"status": {
							"type": "string",
							"pattern": "^([Pp][Aa][Ss][Ss]|[Oo][Kk]|[Uu][Pp]|[Ww][Aa][Rr][Nn]|[Ff][Aa][Ii][Ll]|[Ee][Rr][Rr][Oo][Rr]|[Dd][Oo][Ww][Nn])$",
							"description": "pass, warn or fail, in any case; ok and up mean pass, error and down fail"
						},
						"observedValue": {},
						"observedUnit": {
							"type": "string"
						},
						"time": {
							"type": "string",
							"format": "date-time"
						},
						"output": {
							"type": "string"
						},
						"affectedEndpoints": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"links": {
							"type": "object",
							"additionalProperties": {
								"type": "string",
								"format": "uri"
							}
						}
					}
				}
			},
			"propertyNames": {
				"type": "string",
				"pattern": "^[^:]*(:[^:]*)?$"
			}
		},
		"links": {
			"type": "object",
			"additionalProperties": {
				"type": "string",
				"format": "uri"
			}
		}
	},
	"required": ["status"],
	"title": "Health Check Response",
	"description": "The application/health+json format for reporting a service's health"
}
