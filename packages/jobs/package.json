{
	"name": "@sdxc/jobs",
	"version": "0.0.1",
	"description": "Declared background jobs dispatched over a pluggable queue backend",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./cli": "./src/cli.ts",
		"./cloudflare": "./src/adapters/cloudflare.ts",
		"./conformance": "./src/testing/conformance.ts",
		"./errors": "./src/errors.ts",
		"./memory": "./src/adapters/memory.ts",
		"./queue": "./src/queue.ts",
		"./router": "./src/router.ts",
		"./uptime": "./src/uptime.ts"
	},
	"scripts": {
