{
	"name": "@sdxc/trace-context",
	"version": "0.0.1",
	"description": "W3C Trace Context: traceparent and tracestate, one trace per invocation, propagated to jobs and outbound requests",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./middleware": "./src/middleware.ts",
		"./traceparent": "./src/traceparent.ts",
		"./tracestate": "./src/tracestate.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/crypto": "workspace:*",
		"@sdxc/logger": "workspace:*",
		"@sdxc/result": "workspace:*",
		"remix": "3.0.0-rc.4"
	}
}
