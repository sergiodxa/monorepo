{
	"name": "@sdxc/ui",
	"version": "0.0.1",
	"description": "Styled, accessible remix/component components rendered as server HTML",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./animations": "./src/animations/index.ts",
		"./behaviors": "./src/behaviors/index.ts",
		"./mixins": "./src/mixins/index.ts",
		"./patterns": "./src/patterns/index.ts",
		"./styles": "./src/styles/index.ts",
		"./utils": "./src/utils/index.ts",
		"./reset.css": "./src/reset.css",
		"./theme.css": "./src/theme.css",
		"./*": "./src/components/*.tsx"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@remix-run/ui": "0.12.1",
		"@sdxc/icons": "workspace:*",
		"@sdxc/iife": "workspace:*",
		"@sdxc/u": "workspace:*",
		"@sdxc/uuid": "workspace:*"
	},
	"devDependencies": {
		"remix": "3.1.0"
	},
	"peerDependencies": {
		"remix": "3.1.0"
	}
}
