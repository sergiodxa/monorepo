# The Worker's secrets, with values for local development. `sdxc create` copies this file to
# `.dev.vars`, which `bun dev` reads; copy it yourself in a fresh clone. Set each one for
# production with `cf workers secrets update <NAME>` before the first deploy.

# Signs the session cookie. Use a long random value in production; changing it signs every
# visitor out.
SESSION_SECRET=development-session-secret

# Signs the honeypot fields every page form carries. Use a long random value in production.
HONEYPOT_SECRET=development-honeypot-secret

# Cloudflare Turnstile, which a form asks a visitor to pass. These are Cloudflare's test keys,
# which render a visible widget that always passes; create a widget in the Cloudflare dashboard
# for the production keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
