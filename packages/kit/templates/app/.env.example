# The Worker's secrets, with values for local development. `sdxc create` copies this file to
# `.dev.vars`, which `bun dev` reads; copy it yourself in a fresh clone. Set each one for
# production with `cf workers secrets update <NAME>` before the first deploy.

# Signs the honeypot fields every page form carries. Use a long random value in production.
HONEYPOT_SECRET=development-honeypot-secret
