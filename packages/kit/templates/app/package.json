{
	"name": "app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp build",
		"cf:deploy": "cf deploy --prebuilt",
		"cf:typegen": "cf workers types",
		"check": "vp check",
		"cli": "bun ./bootstrap/cli.ts",
		"db:local:migrate": "cf d1 migrations apply 00000000-0000-4000-8000-000000000000 --dir ./database/migrations --local --persist-to ./.cloudflare/state",
		"db:remote:migrate": "cf d1 migrations apply 00000000-0000-4000-8000-000000000000 --dir ./database/migrations",
		"dev": "vp dev",
		"start": "vp preview",
		"test": "vp test run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@pitlane/assets": "0.1.0",
		"@sdxc/assets-middleware": "0.0.1",
		"@sdxc/captcha": "0.0.1",
		"@sdxc/cli": "0.0.1",
		"@sdxc/data-table-d1": "0.0.1",
		"@sdxc/database-middleware": "0.0.1",
		"@sdxc/get-client-ip": "0.0.1",
		"@sdxc/honeypot": "0.0.1",
		"@sdxc/jobs": "0.0.1",
		"@sdxc/json-schema": "0.0.1",
		"@sdxc/lazy-route": "0.0.1",
		"@sdxc/logger": "0.0.1",
		"@sdxc/mcp": "0.0.1",
		"@sdxc/openapi": "0.0.1",
		"@sdxc/problem": "0.0.1",
		"@sdxc/rate-limit": "0.0.1",
		"@sdxc/security-headers": "0.0.1",
		"@sdxc/session-storage-kv": "0.0.1",
		"@sdxc/spam": "0.0.1",
		"@sdxc/trace-context": "0.0.1",
		"@sdxc/ui": "0.0.1",
		"remix": "3.0.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
		"@pitlane/vite-plugin-remix": "0.8.0",
		"@sdxc/cloudflare-mocks": "0.0.1",
		"@types/node": "^26.6.5",
		"cf": "1.0.0-beta.5",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
		"vite-plus": "0.3.3",
		"vitest": "4.1.11"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
	},
	"packageManager": "bun@1.4.2"
