{
	"name": "@sdxc/kit",
	"version": "0.0.1",
	"description": "The sdxc command line: start a Remix v3 app, generate its files, copy UI components into it and upgrade it",
	"license": "MIT",
	"bin": {
		"sdxc": "./src/bin.ts"
	},
	"type": "module",
	"exports": {
		".": "./src/cli.ts",
		"./doctor": "./src/doctor/define.ts",
		"./config.schema.json": "./config.schema.json",
		"./lock.schema.json": "./lock.schema.json"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/cli": "workspace:*",
		"@sdxc/codemod": "workspace:*",
		"@sdxc/cron": "workspace:*",
		"@sdxc/diagram": "workspace:*",
		"@sdxc/json-schema": "workspace:*",
		"@sdxc/jsonc": "workspace:*",
		"@sdxc/jsonl": "workspace:*",
		"@sdxc/result": "workspace:*",
		"@sdxc/semver": "workspace:*",
		"oxc-parser": "^0.154.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
		"@pitlane/assets": "0.1.0",
		"@pitlane/vite-plugin-remix": "0.8.0",
		"cf": "1.0.0-beta.5",
		"remix": "3.0.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
	},
	"peerDependencies": {
		"remix": "3.0.0"
	}
}
