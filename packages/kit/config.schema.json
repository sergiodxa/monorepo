{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "The JSON Schema editors check this file against"
		},
		"ui": {
			"type": "object",
			"properties": {
				"directory": {
					"type": "string",
					"default": "resources/components/ui",
					"description": "Where `sdxc ui add` writes components"
				},
				"alias": {
					"type": "string",
					"description": "Import prefix for the copies; inferred from tsconfig `paths` when omitted",
					"examples": ["~/components/ui"]
				},
				"tests": {
					"type": "boolean",
					"default": false,
					"description": "Copy a component's tests beside it"
				}
			},
			"additionalProperties": false,
			"default": {
				"directory": "resources/components/ui",
				"tests": false
			}
		},
		"make": {
			"type": "object",
			"properties": {
				"routes": {
					"type": "string",
					"default": "web",
					"description": "Route contract `sdxc make controller` adds to, a module in routes/"
				},
				"migrations": {
					"type": "object",
					"additionalProperties": {
						"type": "string"
					},
					"default": {
						"default": "database/migrations"
					},
					"description": "Migration chains by name; `--chain <name>` picks one"
				},
				"tests": {
					"type": "boolean",
					"default": true,
					"description": "Write a test beside every generated file except migrations and factories"
				},
				"specs": {
					"type": "boolean",
					"default": true,
					"description": "Write a pairing .spec under spec/ for controllers, commands, MCP tools and scaffolds"
				},
				"stubs": {
					"type": "string",
					"default": ".config/sdxc/stubs",
					"description": "Stubs here replace the built-in ones; `sdxc make stubs` copies them out"
				}
			},
			"additionalProperties": false,
			"default": {
				"routes": "web",
				"migrations": {
					"default": "database/migrations"
				},
				"tests": true,
				"specs": true,
				"stubs": ".config/sdxc/stubs"
			}
		},
		"doctor": {
			"type": "object",
			"properties": {
				"checks": {
					"type": "string",
					"default": ".config/sdxc/checks",
					"description": "Folder of the project's own checks, each module run by `sdxc doctor`"
				},
				"migrations": {
					"type": "object",
					"properties": {
						"accept": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"file": {
										"type": "string",
										"description": "Migration file name, without its folder"
									},
									"column": {
										"type": "string",
										"description": "Column SQLite's error names"
									}
								},
								"required": ["file", "column"],
								"additionalProperties": false
							},
							"default": [],
							"description": "Migration errors `sdxc doctor` steps past, each a file that already ran and the column its error names"
						}
					},
					"additionalProperties": false,
					"default": {
						"accept": []
					}
				},
				"complexity": {
					"type": "object",
					"properties": {
						"max": {
							"type": "integer",
							"minimum": 1,
							"default": 4,
							"description": "Maximum cyclomatic complexity per function; the complexity check warns above it"
						}
					},
					"additionalProperties": false,
					"default": {
						"max": 4
					}
				},
				"moduleSize": {
					"type": "object",
					"properties": {
						"maxLines": {
							"type": "integer",
							"minimum": 1,
							"default": 200,
							"description": "Maximum code lines per module; the module-size check warns above it"
						}
					},
					"additionalProperties": false,
					"default": {
						"maxLines": 200
					}
				},
				"crap": {
					"type": "object",
					"properties": {
						"max": {
							"type": "integer",
							"minimum": 1,
							"default": 12,
							"description": "Maximum CRAP score per function; the crap check warns above it"
						},
						"coverage": {
							"type": "string",
							"default": "coverage/coverage-final.json",
							"description": "Istanbul coverage-final.json the crap check reads, relative to the project root"
						}
					},
					"additionalProperties": false,
					"default": {
						"max": 12,
						"coverage": "coverage/coverage-final.json"
					}
				},
				"testRatio": {
					"type": "object",
					"properties": {
						"min": {
							"type": "number",
							"minimum": 0,
							"default": 0.3,
							"description": "Minimum tests/code ratio from sdxc stats; the test-ratio check warns below it"
						}
					},
					"additionalProperties": false,
					"default": {
						"min": 0.3
					}
				},
				"fanOut": {
					"type": "object",
					"properties": {
						"max": {
							"type": "integer",
							"minimum": 1,
							"default": 15,
							"description": "Maximum distinct modules one file may import; the fan-out check warns above it"
						}
					},
					"additionalProperties": false,
					"default": {
						"max": 15
					}
				},
				"duplication": {
					"type": "object",
					"properties": {
						"minLines": {
							"type": "integer",
							"minimum": 2,
							"default": 8,
							"description": "Minimum consecutive code lines that count as a duplicated block"
						}
					},
					"additionalProperties": false,
					"default": {
						"minLines": 8
					}
				},
				"mutation": {
					"type": "object",
					"properties": {
						"report": {
							"type": "string",
							"default": "reports/mutation/mutation.json",
							"description": "Mutation report JSON the mutation check reads, relative to the project root"
						},
						"maxSurvived": {
							"type": "integer",
							"minimum": 0,
							"default": 0,
							"description": "Maximum surviving mutants the mutation check allows"
						}
					},
					"additionalProperties": false,
					"default": {
						"report": "reports/mutation/mutation.json",
						"maxSurvived": 0
					}
				}
			},
			"additionalProperties": false,
			"default": {
				"checks": ".config/sdxc/checks",
				"migrations": {
					"accept": []
				},
				"complexity": {
					"max": 4
				},
				"moduleSize": {
					"maxLines": 200
				},
				"crap": {
					"max": 12,
					"coverage": "coverage/coverage-final.json"
				},
				"testRatio": {
					"min": 0.3
				},
				"fanOut": {
					"max": 15
				},
				"duplication": {
					"minLines": 8
				},
				"mutation": {
					"report": "reports/mutation/mutation.json",
					"maxSurvived": 0
				}
			}
		},
		"run": {
			"type": "object",
			"properties": {
				"entry": {
					"type": "string",
					"default": "bootstrap/cli.ts",
					"description": "Module `sdxc run` starts, relative to the project root; apps keep the default"
				}
			},
			"additionalProperties": false,
			"default": {
				"entry": "bootstrap/cli.ts"
			}
		},
		"format": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"minItems": 1,
			"description": "Command run on every file the CLI writes or edits, paths appended",
			"examples": [["bunx", "vp", "fmt", "--no-error-on-unmatched-pattern"]]
		},
		"lock": {
			"type": "string",
			"default": ".config/sdxc.lock.jsonl",
			"description": "Where the CLI keeps its state; commit it with the project"
		}
	},
	"additionalProperties": false
}
