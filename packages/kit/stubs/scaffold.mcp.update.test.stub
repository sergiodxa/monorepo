/**
 * The `update_{{snake}}` tool, called over `/mcp` as a client calls it: as a member, whom
 * `{{path}}.update` allows, and as a guest, whom it refuses.
 *
 * @see {@link https://sdxc.dev/docs/operations-and-testing/mcp-server}
 * @see {@link https://sdxc.dev/docs/operations-and-testing/testing}{{header}}
 */

import { beforeAll, describe, expect, test } from "vitest";

import { factories, migrate } from "~/app/test/database";
import { callTool } from "~/app/test/mcp";
import { {{Name}}Factory } from "~/database/factories/{{name}}";

beforeAll(migrate);

describe("update_{{snake}}", () => {
	test("changes the fields it names and keeps the rest", async () => {
		let row = await factories().create({{Name}}Factory);

		let result = await callTool("update_{{snake}}", { id: row.id, {{changedJson}} }, "member");

		expect(result.isError).toBe(false);
		expect(JSON.parse(result.text)).toMatchObject({ id: row.id, {{changedJson}} });
	});

	test("reports an id no {{words}} has", async () => {
		let result = await callTool("update_{{snake}}", { id: "missing" }, "member");

		expect(result.isError).toBe(true);
	});

	test("refuses a guest", async () => {
		let row = await factories().create({{Name}}Factory);

		let result = await callTool("update_{{snake}}", { id: row.id, {{changedJson}} });

		expect(result.isError).toBe(true);
	});
});
