/**
 * The {{title}} form: the page that shows it and the action that receives it. Describe what
 * a submission changes and where the visitor lands afterwards.
 */

import { HoneypotFields } from "@sdxc/honeypot/ui";
import { unwrap } from "@sdxc/result";
import { createController } from "remix/router";

import page from "~/app/http/middleware/page";
import DocumentLayout from "~/resources/layouts/document";
import routes from "{{routes}}";

export default createController(routes.{{path}}, {
	middleware: page,
	actions: {
		/** Renders the form with fresh honeypot fields, which the page middleware checks on submit. */
		async index(ctx) {
			let fields = unwrap(await ctx.honeypot.issue());
			return ctx.render(
				<DocumentLayout assets={ctx.assets} title="{{title}}">
					<h1>{{title}}</h1>
					<form method="post" action={routes.{{path}}.action.href()}>
						<HoneypotFields {...fields} />
						<button type="submit">Send</button>
					</form>
				</DocumentLayout>,
			);
		},

		/** Receives a submission and sends the visitor back to the form. */
		action() {
			return new Response(null, {
				status: 303,
				headers: { location: routes.{{path}}.index.href() },
			});
		},
	},
});
