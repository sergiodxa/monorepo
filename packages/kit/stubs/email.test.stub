/**
 * The {{title}} email, rendered through the app's email registry.
 *
 * @see {@link https://sdxc.dev/docs/data-and-background-work/send-email}
 * @see {@link https://sdxc.dev/docs/operations-and-testing/testing}{{header}}
 */

import { unwrap } from "@sdxc/result";
import { describe, expect, test } from "vitest";

import emails from "~/app/emails";
import { mail } from "~/app/initializers/mail";

describe("{{title}} email", () => {
	test("renders its props into the subject and both body parts", async () => {
		let rendered = unwrap(await mail.render(emails.{{path}}, { props: {{sample}} }));

		expect(rendered.subject).toBe({{subjectSample}});
		expect(rendered.text).toContain({{textSample}});
	});
});
