/**
 * The scheduled {{title}} job: describe what each run sweeps or reports, and why on this
 * schedule.
 */

import { createJobHandler } from "@sdxc/jobs";

import jobs from "~/app/jobs";

export default createJobHandler(jobs.{{path}}, async (ctx) => {
	ctx.log.set({ job: { name: "{{name}}" } });
});
