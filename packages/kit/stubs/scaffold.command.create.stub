/**
 * `{{plural}} create`: writes a {{words}} from a flag per field and prints its id, so a script can
 * pass it on. Each run writes another {{words}}; a write the database refuses fails the run.
 *
 * @see {@link https://sdxc.dev/docs/operations-and-testing/your-apps-command-line}
 * @see {@link https://sdxc.dev/api/cli}{{header}}
 */

import { createCommand, success } from "@sdxc/cli";
import { isFailure } from "@sdxc/result";

import commandset from "~/app/commands";
import { {{Name}} } from "~/app/models/{{name}}";

export default createCommand(commandset{{pluralMember}}.create, async (ctx) => {
	let created = await {{Name}}.bind({ db: ctx.db }).create({
{{createValues}}
	});
	if (isFailure(created)) return created;
	ctx.stdout(`${created.data.id}\n`);
	return success();
});
