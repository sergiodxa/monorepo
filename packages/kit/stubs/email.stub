/**
 * The {{title}} email: describe who receives it and what it tells them. Its props are declared
 * in `app/emails/index.ts`; translate copy with `handle.props.t`, in `handle.props.locale`.
 *
 * @see {@link https://sdxc.dev/docs/data-and-background-work/send-email}
 * @see {@link https://sdxc.dev/api/mail}{{header}}
 */

import { createEmail, Email } from "@sdxc/mail";

import emails from "~/app/emails";

export default createEmail(emails.{{path}}, {
	subject: {{subject}},
	body: (handle) => () => (
		<Email.Layout lang={handle.props.locale} title={{layoutTitle}}>
{{body}}
		</Email.Layout>
	),
	preview: () => ({{preview}}),
});
