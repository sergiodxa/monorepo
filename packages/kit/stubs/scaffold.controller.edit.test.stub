/**
 * One {{words}}'s edit form through the app's router, so the honeypot check runs as in the Worker.
 * Its controller loads with the file, keeping its cold import outside each test's time limit.
 *
 * @see {@link https://sdxc.dev/docs/building-remix-apps/forms-and-params}
 * @see {@link https://sdxc.dev/docs/operations-and-testing/testing}{{header}}
 */

import { unwrap } from "@sdxc/result";
import { beforeAll, describe, expect, test } from "vitest";

import "~/app/http/controllers/{{plural}}/edit";
import { honeypot } from "~/app/initializers/honeypot";
import { createWebRouter } from "~/app/initializers/router";
import { factories, migrate } from "~/app/test/database";
import { {{Name}}Factory } from "~/database/factories/{{name}}";
import routes from "~/routes/web";

beforeAll(migrate);

/** Posts `fields` to the update action of the {{words}} with `id`, with valid honeypot fields. */
async function submit(id: string, fields: Record<string, string>) {
	let { token, tokenField } = unwrap(await honeypot.issue());
	return createWebRouter().fetch(
		new Request(new URL(routes.{{pluralKey}}.edit.action.href({ id }), "https://example.com"), {
			method: "POST",
			body: new URLSearchParams({ ...fields, [tokenField]: token }),
		}),
	);
}

describe("{{plural}}/edit", () => {
	test("renders the form filled with the {{words}}'s values", async () => {
		let row = await factories().create({{Name}}Factory);

		let response = await createWebRouter().fetch(
			new URL(routes.{{pluralKey}}.edit.index.href({ id: row.id }), "https://example.com"),
		);

		expect(response.status).toBe(200);
		expect(await response.text()).toContain(
			`action="${routes.{{pluralKey}}.edit.action.href({ id: row.id })}"`,
		);
	});

	test("saves the {{words}} and redirects to its page", async () => {
		let row = await factories().create({{Name}}Factory);

		let response = await submit(row.id, { {{formSample}} });

		expect(response.status).toBe(303);
		expect(response.headers.get("location")).toBe(routes.{{pluralKey}}.show.href({ id: row.id }));
	});

	test("renders the form again for a refused submission", async () => {
		let row = await factories().create({{Name}}Factory);

		let response = await submit(row.id, { {{invalidForm}} });

		expect(response.status).toBe(422);
	});

	test("answers 404 for an id no {{words}} has", async () => {
		let response = await submit("missing", { {{formSample}} });

		expect(response.status).toBe(404);
	});
});
