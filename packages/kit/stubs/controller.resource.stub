/**
 * The {{title}} page, for a visitor `{{ability}}` admits: describe what they find here and why
 * the route exists.
 *
 * @see {@link https://sdxc.dev/docs/building-remix-apps/wire-the-router}
 * @see {@link https://sdxc.dev/docs/identity-and-security/authorization}{{header}}
 */

import { createAction } from "remix/router";

import page from "~/app/http/middleware/page";
import abilities from "~/app/policies/abilities";
import DocumentLayout from "~/resources/layouts/document";
import routes from "{{routes}}";

export default createAction(routes.{{path}}, {
	middleware: page,
	/** Renders the {{title}} page once `ctx.access` admits `{{ability}}`. */
	async handler(ctx) {
		{{pageAccess}}
		return ctx.render(
			<DocumentLayout assets={ctx.assets} intl={ctx.intl} url={ctx.url} title="{{title}}">
				<h1>{{title}}</h1>
				{/* TODO: render the page */}
			</DocumentLayout>,
		);
	},
});
