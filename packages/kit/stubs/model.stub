/**
 * The {{title}} model and its table: describe what a row records and the rules that keep it
 * consistent. Keep the columns in step with the migration that creates the table.{{header}}
 */

import type { TableRow } from "remix/data-table";

import { column as c, table } from "remix/data-table";
import { createModel } from "@sdxc/data-model";
import { generateUUID } from "@sdxc/uuid/v7";

/** The `{{snake}}` table, as its migration creates it. */
export const {{key}}Table = table({
	name: "{{snake}}",
	columns: {
		id: c.text().primaryKey(),
		created_at: c.integer(),
		updated_at: c.integer(),
	},
	/** `create` and `update` stamp `created_at` and `updated_at` with the database's clock. */
	timestamps: true,
});

/** One {{title}} row as it reads back from the database. */
export type {{Name}}Row = TableRow<typeof {{key}}Table>;

export const {{Name}} = createModel({{key}}Table, {
	optional: ["id"],
	callbacks: {
		/** Gives a new row a time-ordered UUID, so ids sort by creation and never repeat. */
		async beforeCreate(values) {
			return { ...values, id: values.id ?? generateUUID() };
		},
	},
});

export default {{Name}};
