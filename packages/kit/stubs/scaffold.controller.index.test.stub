/**
 * The {{pluralWords}} index page, rendered through the app's router. Its controller loads with
 * the file, so the cold import of its views stays outside each test's time limit.
 *
 * @see {@link https://sdxc.dev/docs/building-remix-apps/wire-the-router}
 * @see {@link https://sdxc.dev/docs/operations-and-testing/testing}{{header}}
 */

import { beforeAll, describe, expect, test } from "vitest";

import "~/app/http/controllers/{{plural}}/index";
import { createWebRouter } from "~/app/initializers/router";
import { factories, migrate } from "~/app/test/database";
import { {{Name}}Factory } from "~/database/factories/{{name}}";
import routes from "~/routes/web";

beforeAll(migrate);

describe("{{plural}}/index", () => {
	test("lists each {{words}}, linking to its page", async () => {
		let row = await factories().create({{Name}}Factory);

		let response = await createWebRouter().fetch(
			new URL(routes.{{pluralKey}}.index.href(), "https://example.com"),
		);

		expect(response.status).toBe(200);
		expect(await response.text()).toContain(
			`href="${routes.{{pluralKey}}.show.href({ id: row.id })}"`,
		);
	});
});
