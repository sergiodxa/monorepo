/**
 * Answers `delete_{{snake}}`: deletes the {{words}} with the id and answers it as it was. An id
 * no {{words}} has, or one `{{path}}.read` hides, is a tool error; a caller `{{path}}.delete`
 * refuses is a forbidden call.
 *
 * @see {@link https://sdxc.dev/docs/operations-and-testing/mcp-server}
 * @see {@link https://sdxc.dev/api/mcp}{{header}}
 */

import { createTool, ForbiddenError, ToolError } from "@sdxc/mcp/server";
import { isFailure } from "@sdxc/result";

import toolset from "~/app/mcp/tools";
import { {{Name}} } from "~/app/models/{{name}}";
import abilities from "~/app/policies/abilities";

export default createTool(toolset.{{pluralKey}}.delete, async (ctx) => {
	let model = {{Name}}.bind({ db: ctx.db });
	let row = await model.find(ctx.input.id);
	if (row === null || !ctx.access.can(abilities.{{path}}.read, { {{key}}: row })) {
		throw new ToolError(`No {{words}} has the id ${ctx.input.id}; list_{{pluralSnake}} lists them.`);
	}
	if (!ctx.access.can(abilities.{{path}}.delete, { {{key}}: row })) {
		throw new ForbiddenError("{{path}}.delete is not permitted");
	}
	let deleted = await model.delete(ctx.input.id);
	if (isFailure(deleted)) {
		throw new ToolError(`No {{words}} has the id ${ctx.input.id}; list_{{pluralSnake}} lists them.`);
	}
	return deleted.data;
});
