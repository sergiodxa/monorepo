/**
 * The {{title}} page: describe what a visitor finds here and why the route exists.
 */

import { createAction } from "remix/router";

import page from "~/app/http/middleware/page";
import DocumentLayout from "~/resources/layouts/document";
import routes from "{{routes}}";

export default createAction(routes.{{path}}, {
	middleware: page,
	/** Renders the {{title}} page. */
	handler: (ctx) =>
		ctx.render(
			<DocumentLayout assets={ctx.assets} intl={ctx.intl} title="{{title}}">
				<h1>{{title}}</h1>
			</DocumentLayout>,
		),
});
