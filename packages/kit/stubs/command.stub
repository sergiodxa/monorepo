/**
 * `{{command}}`: describe what it changes, what it prints, and whether it is safe to run twice.
 *
 * @see {@link https://sdxc.dev/docs/operations-and-testing/your-apps-command-line}
 * @see {@link https://sdxc.dev/api/cli}{{header}}
 */

import { createCommand, success } from "@sdxc/cli";

import commandset from "~/app/commands";

export default createCommand(commandset{{member}}, (ctx) => {
	ctx.stdout("{{title}}\n");
	return success();
});
