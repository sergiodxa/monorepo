/**
 * The {{title}} form, rendered and submitted through the app's router, so every middleware
 * and the page chain's checks run as they do in the Worker.{{header}}
 */

import { unwrap } from "@sdxc/result";
import { describe, expect, test } from "vitest";

import { honeypot } from "~/app/initializers/honeypot";
import { createWebRouter } from "~/app/initializers/router";
import routes from "{{routes}}";

/** Posts `form` to the form's action. */
function submit(form: Record<string, string>) {
	return createWebRouter().fetch(
		new Request(new URL(routes.{{path}}.action.href(), "https://example.com"), {
			method: "POST",
			body: new URLSearchParams(form),
		}),
	);
}

describe("{{name}}", () => {
	test("renders the form with its honeypot fields and CAPTCHA widget", async () => {
		let response = await createWebRouter().fetch(
			new URL(routes.{{path}}.index.href(), "https://example.com"),
		);

		expect(response.status).toBe(200);
		let html = await response.text();
		expect(html).toContain(`name="${honeypot.tokenField}"`);
		expect(html).toContain('class="cf-turnstile"');
	});

	test("refuses a submission without the honeypot fields", async () => {
		let response = await submit({});

		expect(response.status).toBe(400);
	});

	test("refuses a submission that filled the trap", async () => {
		let { token, tokenField, trapField } = unwrap(await honeypot.issue());

		let response = await submit({ [tokenField]: token, [trapField]: "https://spam.example" });

		expect(response.status).toBe(400);
	});

	test("refuses a submission without a CAPTCHA token", async () => {
		let { token, tokenField } = unwrap(await honeypot.issue());

		let response = await submit({ [tokenField]: token });

		expect(response.status).toBe(403);
	});

	test.todo("saves a {{title}} submission");
});
