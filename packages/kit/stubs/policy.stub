/**
 * The {{title}} policy: describe who may do what, and why the rule sits here.
 *
 * @see {@link https://sdxc.dev/docs/identity-and-security/authorization}
 * @see {@link https://sdxc.dev/api/authz}{{header}}
 */

/** Who an authorization rule is asked about; `null` for an anonymous visitor. */
export interface Actor {
	id: string;
}

/** Whether `actor` passes the {{title}} rule. */
export function {{key}}(actor: Actor | null): boolean {
	return actor !== null;
}
