{
	"name": "@sdxc/security-headers",
	"version": "0.0.1",
	"description": "Typed CSP, Permissions-Policy and security response headers, with middleware",
	"license": "MIT",
	"bin": {
		"sdxc-security-headers": "./src/cli.ts"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./csp": "./src/csp.ts",
		"./permissions-policy": "./src/permissions-policy.ts",
		"./reports": "./src/reports.ts",
		"./audit": "./src/audit.ts",
		"./middleware": "./src/middleware.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/cli": "workspace:*",
		"@sdxc/crypto": "workspace:*",
		"@sdxc/result": "workspace:*",
		"@sdxc/structured-fields": "workspace:*"
	},
	"devDependencies": {
		"remix": "3.1.0"
	},
	"peerDependencies": {
		"remix": "3.1.0"
	}
}
