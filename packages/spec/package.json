{
	"name": "@sdxc/spec",
	"version": "0.0.1",
	"description": "Executable specification runner for .spec files",
	"license": "MIT",
	"bin": {
		"spec": "./src/cli.ts"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./workers": "./src/workers.ts",
		"./browser-run": "./src/browser-run.ts"
	},
	"scripts": {
		"build": "bun build ./src/cli.ts --compile --outfile bin/spec",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/cli": "workspace:*",
		"@sdxc/duration": "workspace:*",
		"@sdxc/html": "workspace:*",
		"@sdxc/iife": "workspace:*",
		"@sdxc/jsonc": "workspace:*",
		"@sdxc/jsonl": "workspace:*",
		"@sdxc/random": "workspace:*",
		"@sdxc/result": "workspace:*",
		"@sdxc/sample": "workspace:*",
		"remix": "3.0.0"
	}
}
