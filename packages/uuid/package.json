{
	"name": "@sdxc/uuid",
	"version": "0.0.1",
	"description": "Validate and assert UUIDs behind a branded UUID type, and generate v4 or v7 values",
	"license": "MIT",
	"bin": {
		"sdxc-uuid": "./src/cli.ts"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./v4": "./src/v4.ts",
		"./v7": "./src/v7.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/cli": "workspace:*",
		"@sdxc/result": "workspace:*",
		"remix": "3.2.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.5"
	}
}
