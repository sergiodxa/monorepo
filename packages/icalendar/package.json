{
	"name": "@sdxc/icalendar",
	"version": "0.0.1",
	"description": "Read and write iCalendar documents, with recurrence rules and time zones",
	"license": "MIT",
	"bin": {
		"sdxc-icalendar": "./src/cli.ts"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./rrule": "./src/rrule.ts",
		"./timezone": "./src/timezone.ts",
		"./itip": "./src/itip.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/cli": "workspace:*",
		"@sdxc/dates": "workspace:*",
		"@sdxc/result": "workspace:*",
		"remix": "3.1.0"
	}
}
