{
	"name": "@sdxc/markdown",
	"version": "0.0.1",
	"description": "GitHub Flavored Markdown: parse to a typed AST, transform it, write it back",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./html": "./src/html/index.ts",
		"./plain": "./src/plain/index.ts",
		"./remix": "./src/remix/index.tsx"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/result": "workspace:*",
		"@sdxc/yaml": "workspace:*",
		"@standard-schema/spec": "^1.1.0",
		"remix": "3.0.0-rc.2"
	}
}
