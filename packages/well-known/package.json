{
	"name": "@sdxc/well-known",
	"version": "0.0.1",
	"description": "Typed documents for well-known URIs: security.txt, WebFinger, NodeInfo, OAuth and OIDC metadata, JWKS and more",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./security-txt": "./src/security-txt.ts",
		"./webfinger": "./src/webfinger.ts",
		"./oauth-authorization-server": "./src/oauth-authorization-server.ts",
		"./openid-configuration": "./src/openid-configuration.ts",
		"./oauth-protected-resource": "./src/oauth-protected-resource.ts",
		"./jwks": "./src/jwks.ts",
		"./change-password": "./src/change-password.ts",
		"./passkey-endpoints": "./src/passkey-endpoints.ts",
		"./nodeinfo": "./src/nodeinfo.ts",
		"./response": "./src/response.ts",
		"./middleware": "./src/middleware.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@remix-run/data-schema": "^1.0.0",
		"@sdxc/result": "workspace:*",
		"@standard-schema/spec": "^1.1.0"
	},
	"devDependencies": {
		"@sdxc/http": "workspace:*",
		"@sdxc/jwt": "workspace:*",
		"remix": "3.0.0"
	},
	"peerDependencies": {
		"@sdxc/http": "workspace:*",
		"remix": "3.0.0"
	},
	"peerDependenciesMeta": {
		"@sdxc/http": {
			"optional": true
		},
		"remix": {
			"optional": true
		}
	}
}
