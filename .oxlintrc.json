{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"eslint",
		"import",
		"jsdoc",
		"jsx-a11y",
		"node",
		"oxc",
		"promise",
		"react-perf",
		"react",
		"typescript",
		"unicorn"
	],
	"categories": {},
	"rules": {
		"jsx_a11y/control-has-associated-label": "allow",
		"jsx_a11y/no-noninteractive-element-interactions": "allow",
		"jsx_a11y/prefer-tag-over-role": "allow"
	},
	"settings": {
		"jsx-a11y": {
			"components": {
				"Input": "input",
				"Select": "select",
				"Button": "button"
			}
		}
	},
	"env": {
		"builtin": true
	},
	"globals": {},
	"ignorePatterns": ["templates/app/database/schema.ts"]
}
