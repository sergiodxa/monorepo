{
	"extends": "../../tsconfig.json",
	"include": ["src/**/*", "scripts/**/*"],
	"exclude": ["src/game/data/idea.ts"],
	"compilerOptions": {
		"noEmit": true,
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"jsxImportSource": "remix/component",
		"types": ["bun", "node"],
