{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "r3-gallery",
	"compatibility_date": "2026-09-02",
	"workers_dev": true,
	"dev": { "port": 3000 },
	"observability": { "enabled": true },
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
	},
}
