{
	"extends": "../../tsconfig.json",
	"include": [
		"config/**/*.d.ts",
		"app/**/*",
		"bootstrap/**/*",
		"routes/**/*",
		"resources/**/*",
		"database/**/*",
		"worker-configuration.d.ts",
		"vite.config.ts"
	],
	"compilerOptions": {
		"noEmit": true,
		"ignoreDeprecations": "6.0",
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"jsxImportSource": "remix/component",
		"types": ["@total-typescript/ts-reset", "vite/client", "@types/bun"],
		"baseUrl": ".",
		"rootDirs": ["."],
		"paths": {
			"~/app/*": ["./app/*"],
			"~/bootstrap/*": ["./bootstrap/*"],
			"~/database/*": ["./database/*"],
			"~/routes/*": ["./routes/*"],
			"~/resources/*": ["./resources/*"]
		}
	}
}
