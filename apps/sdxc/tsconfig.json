{
	"extends": "../../tsconfig.json",
	"include": [
		"config/**/*",
		"app/**/*",
		"bootstrap/**/*",
		"scripts/**/*",
		"routes/**/*",
		"resources/**/*",
		".cloudflare/types/index.d.ts",
		"cloudflare.config.ts",
		"vite.config.ts"
	],
	"compilerOptions": {
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"jsxImportSource": "remix/component",
		"types": ["@total-typescript/ts-reset", "vite/client", "bun", "node"],
		"rootDirs": ["."],
		"paths": {
			"~/config/*": ["./config/*"],
			"~/app/*": ["./app/*"],
			"~/bootstrap/*": ["./bootstrap/*"],
			"~/routes/*": ["./routes/*"],
			"~/resources/*": ["./resources/*"],
			"~/scripts/*": ["./scripts/*"]
		}
	}
}
