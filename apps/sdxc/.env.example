# The changelog reads the repository's GitHub Releases. Unauthenticated requests are
# allowed but share a rate limit with every other caller from the same address, so a
# token raises the ceiling; the page serves its cached copy when the call fails.
GITHUB_TOKEN=

# Signs GitHub's sponsorship webhook (the secret entered when the hook is created on the
# GitHub Sponsors dashboard). Unset, the webhook refuses every delivery.
GITHUB_SPONSORS_WEBHOOK_SECRET=
