{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "sdxc",
	"main": "./bootstrap/worker.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"dev": { "port": 3007 },
	"placement": { "mode": "smart" },

	// Traces are head-sampled at 10%: this is a public documentation site whose pages
	// take crawler and agent traffic, so full tracing is mostly noise.
	"observability": {
		"enabled": true,
		"traces": { "enabled": true, "head_sampling_rate": 0.1 },
	},

	"assets": { "directory": "./build/client" },

	// The custom domain is declared here so a deploy never drops it; rollback is
	// redeploying the previous version rather than moving a domain.
	"routes": [{ "pattern": "sdxc.sergiodxa.com", "custom_domain": true }],

	// The sponsor list is read into KV on a schedule rather than during a request, so a
	// page never waits on GitHub and an outage there leaves the previous list standing.
	// Four times a day is well inside how often the list actually changes.
	"triggers": { "crons": ["0 */6 * * *"] },

	// The stored state is what the site reads back from GitHub — the changelog, and who
	// funds the work — which is what lives outside the bundle. The rest renders from the deploy.
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "006c6214d1d6469787114fe5b30e6e41",
			"preview_id": "006c6214d1d6469787114fe5b30e6e41",
		},
	],
}
