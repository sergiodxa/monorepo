# Session
COOKIE_SESSION_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Polar (customer management). Local development only: in production the token is the
# POLAR_ACCESS_TOKEN Secrets Store binding, which has no value outside Cloudflare's
# network, so this plain var stands in for it when the binding cannot be read.
POLAR_ACCESS_TOKEN_LOCAL=

# API key for self-monitoring cron jobs
UPTIME_CRON_API_KEY=
