# The Worker's secrets, with values for local development. Copy this file to `.dev.vars`,
# which `bun dev` reads. Set each one for production with `cf workers secrets update <NAME>`
# before the first deploy that declares it.

# Signs the session cookie. Use a long random value in production; changing it signs every
# subject out.
COOKIE_SESSION_SECRET=

# The GitHub OAuth app "Sign in with GitHub" goes through.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Polar (customer management). Local development only: in production the token is the
# POLAR_ACCESS_TOKEN Secrets Store binding, which has no value outside Cloudflare's
# network, so this plain var stands in for it when the binding cannot be read.
POLAR_ACCESS_TOKEN_LOCAL=

# Authenticates the ping the daily session sweep sends to the cron monitor watching it.
UPTIME_CRON_API_KEY=
