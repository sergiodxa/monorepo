{
	"name": "@apps/r3-auth",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"cf:deploy": "bunx wrangler deploy",
		"cf:typegen": "bunx wrangler types",
		"db:local:migrate": "bunx wrangler d1 migrations apply DB --local",
		"db:remote:migrate": "bunx wrangler d1 migrations apply DB --remote",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/billing": "workspace:*",
		"@sdxc/crypto": "workspace:*",
		"@sdxc/data-table-d1": "workspace:*",
		"@sdxc/dates": "workspace:*",
		"@sdxc/duration": "workspace:*",
		"@sdxc/get-client-ip": "workspace:*",
		"@sdxc/http": "workspace:*",
		"@sdxc/i18n": "workspace:*",
		"@sdxc/jobs": "workspace:*",
		"@sdxc/jwt": "workspace:*",
		"@sdxc/logger": "workspace:*",
		"@sdxc/mail": "workspace:*",
		"@sdxc/rate-limit": "workspace:*",
		"@sdxc/result": "workspace:*",
		"@sdxc/server-timing": "workspace:*",
		"@sdxc/service-container": "workspace:*",
		"@sdxc/session-storage-kv": "workspace:*",
		"@sdxc/u": "workspace:*",
		"@sdxc/ui": "workspace:*",
		"@sdxc/uuid": "workspace:*",
		"@sdxc/validate": "workspace:*",
		"remix": "3.0.0-rc.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.2",
		"@sdxc/auth": "workspace:*",
		"@sdxc/cloudflare-mocks": "workspace:*",
		"vite": "^8.2.2",
		"wrangler": "^4.127.1"
	}
}
