# Copy to `.dev.vars` for local development, and set each as a Wrangler secret in
# production (`bunx wrangler secret put NAME`). Vars already in wrangler.jsonc
# (PLATFORM_DOMAIN, OIDC_ISSUER) can be overridden here for local runs.

# Dashboard session cookie signing secret (any long random string).
COOKIE_SESSION_SECRET=

# Dashboard OIDC client on the sso.blog.sergiodxa.com auth-saas tenant.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Management (M2M) client used to provision a per-blog OIDC client on the sso tenant.
SSO_MANAGEMENT_CLIENT_ID=
SSO_MANAGEMENT_CLIENT_SECRET=

# Cloudflare API (for SaaS custom hostnames + the Analytics Engine SQL API).
CF_API_TOKEN=
CF_ZONE_ID=
CF_ACCOUNT_ID=

# Polar billing.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
