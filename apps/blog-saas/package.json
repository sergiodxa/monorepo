{
	"name": "@apps/blog-saas",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"cf:deploy": "bunx wrangler deploy",
		"cf:typegen": "bunx wrangler types",
		"db:local:migrate": "bunx wrangler d1 migrations apply blog-saas-platform --local",
		"db:remote:migrate": "bunx wrangler d1 migrations apply blog-saas-platform --remote",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/auth": "workspace:*",
		"@sdxc/billing": "workspace:*",
		"@sdxc/blog-engine": "workspace:*",
		"@sdxc/data-table-d1": "workspace:*",
		"@sdxc/data-table-sqlstorage": "workspace:*",
		"@sdxc/hostname": "workspace:*",
		"@sdxc/http": "workspace:*",
		"@sdxc/jobs": "workspace:*",
		"@sdxc/logger": "workspace:*",
		"@sdxc/result": "workspace:*",
		"@sdxc/service-container": "workspace:*",
		"@sdxc/types": "workspace:*",
		"@sdxc/validate": "workspace:*",
		"remix": "3.0.0-rc.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.2",
		"@sdxc/cloudflare-mocks": "workspace:*",
		"vite": "^8.2.2",
		"wrangler": "^4.127.1"
	}
}
