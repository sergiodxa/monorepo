# Soft-launch (ADR-182): set X402_FACILITATOR_URL to `memory` (or leave empty)
# so priced HTTP/MCP routes run free until a real facilitator + wallet are ready.
# Any other non-http value (e.g. `test-local`) still charges via MemoryFacilitator
# for local settlement tests. Production: an https://… facilitator URL.
X402_FACILITATOR_URL=memory

# Receive wallet (EVM address that holds USDC on Base). Soft-launch can keep the
# placeholder; replace with your Base USDC address when enabling charges.
X402_PAY_TO=0x00000000000000000000000000000000000000fe

# Optional Authorization value for the facilitator (e.g. "Bearer <cdp-jwt>").
# Soft-launch / public facilitators: leave empty (or "-" if the secret store
# rejects empty). Mainnet CDP example facilitator:
# https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_AUTH=

# CAIP-2 network id. Soft-launch / local: Base Sepolia. Charging on mainnet: eip155:8453.
X402_NETWORK=eip155:84532

# USDC asset on that network.
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Operator free pass (used once charging is on). Send as
# `Authorization: Bearer <value>` on priced calls.
# Mint with: bun -e 'import { randomToken } from "@sdxc/crypto"; console.log(randomToken({ prefix: "owner" }))'
OWNER_ACCESS_TOKEN=owner_replace-me
