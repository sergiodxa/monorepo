# Receive wallet (EVM address that holds USDC on Base). Memory facilitator
# ignores the chain but still stamps payTo on challenges.
X402_PAY_TO=0x00000000000000000000000000000000000000fe

# Facilitator base URL, or "memory" for local settlement without a chain.
# Mainnet CDP example: https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_URL=memory

# Optional Authorization value for the facilitator (e.g. "Bearer <cdp-jwt>").
# Leave empty for public facilitators and for memory mode.
X402_FACILITATOR_AUTH=

# CAIP-2 network id. Base Sepolia for local; Base mainnet for production.
X402_NETWORK=eip155:84532

# USDC asset on that network.
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Operator free pass. Send as `Authorization: Bearer <value>` on priced calls.
# Mint with: bun -e 'import { randomToken } from "@sdxc/crypto"; console.log(randomToken({ prefix: "owner" }))'
OWNER_ACCESS_TOKEN=owner_replace-me
