{
	"name": "@apps/auth-saas",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"cf:deploy": "bunx wrangler deploy",
		"cf:typegen": "bunx wrangler types",
		"db:local:drop": "rm -rf ./.wrangler",
		"db:local:migrate": "bunx wrangler d1 migrations apply auth-saas-platform --local",
		"db:remote:migrate": "bunx wrangler d1 migrations apply auth-saas-platform --remote",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/auth": "workspace:*",
		"@sdxc/billing": "workspace:*",
		"@sdxc/captcha": "workspace:*",
		"@sdxc/cloudflare-pricing": "workspace:*",
		"@sdxc/crypto": "workspace:*",
		"@sdxc/data-table-d1": "workspace:*",
		"@sdxc/data-table-sqlstorage": "workspace:*",
		"@sdxc/doh": "workspace:*",
		"@sdxc/duration": "workspace:*",
		"@sdxc/email-address": "workspace:*",
		"@sdxc/flags": "workspace:*",
		"@sdxc/flags-engine": "workspace:*",
		"@sdxc/get-client-ip": "workspace:*",
		"@sdxc/hostname": "workspace:*",
		"@sdxc/http": "workspace:*",
		"@sdxc/i18n": "workspace:*",
		"@sdxc/icons": "workspace:*",
		"@sdxc/idempotency": "workspace:*",
		"@sdxc/jobs": "workspace:*",
		"@sdxc/json-schema": "workspace:*",
		"@sdxc/jwt": "workspace:*",
		"@sdxc/location": "workspace:*",
		"@sdxc/logger": "workspace:*",
		"@sdxc/mail": "workspace:*",
		"@sdxc/merge-patch": "workspace:*",
		"@sdxc/messageformat": "workspace:*",
		"@sdxc/openapi": "workspace:*",
		"@sdxc/pagination": "workspace:*",
		"@sdxc/passkey": "workspace:*",
		"@sdxc/password-policy": "workspace:*",
		"@sdxc/problem": "workspace:*",
		"@sdxc/rate-limit": "workspace:*",
		"@sdxc/response": "workspace:*",
		"@sdxc/result": "workspace:*",
		"@sdxc/saml": "workspace:*",
		"@sdxc/scim": "workspace:*",
		"@sdxc/security-headers": "workspace:*",
		"@sdxc/trace-context": "workspace:*",
		"@sdxc/trailing-slash-middleware": "workspace:*",
