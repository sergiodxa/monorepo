{
	"name": "@apps/auth-saas",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite build --config vite.config.client.ts --watch &  vite dev",
		"build": "vite build --config vite.config.client.ts && vite build",
		"build:client": "vite build --config vite.config.client.ts",
		"start": "vite preview",
		"cf:deploy": "wrangler deploy",
		"cf:typegen": "wrangler types",
		"db:local:drop": "rm -rf ./.wrangler",
		"db:local:migrate": "wrangler d1 migrations apply auth-saas-platform --local",
		"db:remote:migrate": "wrangler d1 migrations apply auth-saas-platform --remote",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@edgefirst-dev/jwt": "^1.3.0",
		"@pkg/cn": "workspace:*",
		"@pkg/data-table-d1": "workspace:*",
		"@pkg/data-table-sqlstorage": "workspace:*",
		"@pkg/db-helpers": "workspace:*",
		"@pkg/get-client-ip": "workspace:*",
		"@pkg/hostname": "workspace:*",
		"@pkg/http": "workspace:*",
		"@pkg/jobs": "workspace:*",
		"@pkg/location": "workspace:*",
		"@pkg/logger": "workspace:*",
		"@pkg/oidc-provider": "workspace:*",
		"@pkg/polar": "workspace:*",
		"@pkg/response": "workspace:*",
		"@pkg/result": "workspace:*",
		"@pkg/service-container": "workspace:*",
		"@pkg/types": "workspace:*",
		"@pkg/ui": "workspace:*",
		"@pkg/validate": "workspace:*",
		"@polar-sh/sdk": "^0.48.1",
		"@simplewebauthn/server": "^13.3.1",
		"bcryptjs": "^3.0.3",
		"remix": "3.0.0-beta.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.42.1",
		"@tailwindcss/vite": "^4.3.1",
		"@types/bcryptjs": "^3.0.0",
		"@types/bun": "^1.3.11",
		"@types/node": "^26.0.0",
		"tailwindcss": "^4.3.1",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.2",
		"vite": "^8.0.16",
		"vite-tsconfig-paths": "^6.1.1",
		"wrangler": "^4.103.0"
	}
}
