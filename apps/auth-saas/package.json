{
	"name": "@apps/auth-saas",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"cf:deploy": "bunx wrangler deploy",
		"cf:typegen": "bunx wrangler types",
		"db:local:drop": "rm -rf ./.wrangler",
		"db:local:migrate": "bunx wrangler d1 migrations apply auth-saas-platform --local",
		"db:remote:migrate": "bunx wrangler d1 migrations apply auth-saas-platform --remote",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/auth": "workspace:*",
		"@sdxc/billing": "workspace:*",
		"@sdxc/crypto": "workspace:*",
		"@sdxc/data-table-d1": "workspace:*",
		"@sdxc/data-table-sqlstorage": "workspace:*",
		"@sdxc/get-client-ip": "workspace:*",
		"@sdxc/hostname": "workspace:*",
		"@sdxc/http": "workspace:*",
		"@sdxc/i18n": "workspace:*",
		"@sdxc/icons": "workspace:*",
		"@sdxc/jobs": "workspace:*",
		"@sdxc/jwt": "workspace:*",
		"@sdxc/location": "workspace:*",
		"@sdxc/logger": "workspace:*",
		"@sdxc/mail": "workspace:*",
		"@sdxc/pagination": "workspace:*",
		"@sdxc/passkey": "workspace:*",
		"@sdxc/response": "workspace:*",
		"@sdxc/result": "workspace:*",
		"@sdxc/typeid": "workspace:*",
		"@sdxc/types": "workspace:*",
		"@sdxc/u": "workspace:*",
		"@sdxc/ui": "workspace:*",
		"@sdxc/user-agent": "workspace:*",
		"@sdxc/uuid": "workspace:*",
		"@sdxc/validate": "workspace:*",
		"remix": "3.0.0-rc.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.2",
		"@sdxc/cloudflare-mocks": "workspace:*",
		"vite": "^8.2.2",
		"wrangler": "^4.127.1"
	}
}
