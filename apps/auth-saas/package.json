		"@sdxc/validate": "workspace:*",
		"@sdxc/webhooks": "workspace:*",
		"@sdxc/well-known": "workspace:*",
		"remix": "3.0.0-rc.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.2",
		"@sdxc/cloudflare-mocks": "workspace:*",
		"vite": "^8.2.2",
		"wrangler": "^4.127.1"
	}
