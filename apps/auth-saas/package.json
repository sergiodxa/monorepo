{
	"name": "@apps/auth-saas",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite build --config vite.config.client.ts --watch & vite build --config vite.config.browser.ts --watch & vite dev",
		"build": "vite build --config vite.config.browser.ts && vite build --config vite.config.client.ts && vite build",
		"build:client": "vite build --config vite.config.browser.ts && vite build --config vite.config.client.ts",
		"start": "vite preview",
		"cf:deploy": "bunx wrangler deploy",
		"cf:typegen": "bunx wrangler types",
		"db:local:drop": "rm -rf ./.wrangler",
		"db:local:migrate": "bunx wrangler d1 migrations apply auth-saas-platform --local",
		"db:remote:migrate": "bunx wrangler d1 migrations apply auth-saas-platform --remote",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@pkg/auth": "workspace:*",
		"@pkg/data-table-d1": "workspace:*",
		"@pkg/data-table-sqlstorage": "workspace:*",
		"@pkg/get-client-ip": "workspace:*",
		"@pkg/hostname": "workspace:*",
		"@pkg/http": "workspace:*",
		"@pkg/jobs": "workspace:*",
		"@pkg/jwt": "workspace:*",
		"@pkg/location": "workspace:*",
		"@pkg/logger": "workspace:*",
		"@pkg/oidc-provider": "workspace:*",
		"@pkg/polar": "workspace:*",
		"@pkg/response": "workspace:*",
		"@pkg/result": "workspace:*",
		"@pkg/service-container": "workspace:*",
		"@pkg/types": "workspace:*",
		"@pkg/validate": "workspace:*",
		"@polar-sh/sdk": "^0.48.1",
		"@simplewebauthn/server": "^13.3.2",
		"remix": "3.0.0-rc.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.52.1",
		"@pkg/cloudflare-mocks": "workspace:*",
		"@types/bun": "^1.3.11",
		"@types/node": "^26.2.0",
		"msw": "^2.15.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "4.1.10",
		"wrangler": "^4.123.0"
	}
}
