{
	"name": "@apps/auth-saas",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite build --config vite.config.client.ts --watch &  vite dev",
		"build": "vite build --config vite.config.client.ts && vite build",
		"build:client": "vite build --config vite.config.client.ts",
		"start": "vite preview",
		"cf:deploy": "wrangler deploy",
		"cf:typegen": "wrangler types",
		"db:local:drop": "rm -rf ./.wrangler",
		"db:local:migrate": "wrangler d1 migrations apply auth-saas-platform --local",
		"db:remote:migrate": "wrangler d1 migrations apply auth-saas-platform --remote"
	},
	"dependencies": {
		"@edgefirst-dev/jwt": "^1.3.0",
		"@pkg/cn": "workspace:*",
		"@pkg/db-helpers": "workspace:*",
		"@pkg/get-client-ip": "workspace:*",
		"@pkg/http": "workspace:*",
		"@pkg/jobs": "workspace:*",
		"@pkg/location": "workspace:*",
		"@pkg/logger": "workspace:*",
		"@pkg/response": "workspace:*",
		"@pkg/result": "workspace:*",
		"@pkg/types": "workspace:*",
		"@pkg/ui": "workspace:*",
		"@pkg/validate": "workspace:*",
		"@polar-sh/sdk": "^0.47.0",
		"@simplewebauthn/server": "^13.3.0",
		"bcryptjs": "^3.0.3",
		"remix": "next",
		"resend": "^6.10.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.31.2",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bcryptjs": "^3.0.0",
		"@types/bun": "^1.3.11",
		"@types/node": "^25.5.2",
		"tailwindcss": "^4.2.2",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.2",
		"vite": "^8.0.8",
		"vite-tsconfig-paths": "^6.1.1",
		"wrangler": "^4.81.1"
	}
}
