# Copy to `.dev.vars` for local development, and set each as a Wrangler secret in
# production (`bunx wrangler secret put NAME`).

# Secret for signing internal Management API tokens (shared with tenant DOs).
INTERNAL_SECRET=

# Secret for signing platform (dashboard) session cookies.
SESSION_SECRET=

# Cloudflare API (for SaaS custom hostnames on the sso.* zone).
CF_API_TOKEN=
CF_ZONE_ID=
CF_ACCOUNT_ID=

# Polar billing (per-tenant subscriptions). Each id map is a JSON object
# mapping our own slugs to this Polar organization's ids; sandbox and
# production share none of them.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# { "free": "...", "pro": "...", "premium": "...", "sso_connections": "...", "scim": "...", "organizations": "...", "custom_roles": "...", "outbound_webhooks": "...", "machine_access": "...", "device_grant": "...", "audit_streaming": "..." }
POLAR_PRODUCT_IDS=
# { "custom_domain": "...", "session_policy": "...", "unbranded_pages": "...", "branding": "...", "sso_connections": "...", "scim": "...", "organizations": "...", "custom_roles": "...", "outbound_webhooks": "...", "machine_access": "...", "device_grant": "...", "audit_streaming": "..." }
POLAR_FEATURE_IDS=
# { "auth.dau": "...", "sso_connections": "..." }
POLAR_METER_IDS=
