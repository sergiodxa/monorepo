{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "auth-saas",
	"main": "./bootstrap/worker.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,

	"dev": { "port": 3004 },

	"placement": { "mode": "off" },

	"observability": { "enabled": true },

	"assets": { "directory": "./assets", "binding": "ASSETS" },

	// The platform Worker runs on the platform domain (custom_domain). The wildcard
	// route covers every default tenant subdomain ({slug}.auth.sergiodxa.com) that
	// tenant creation provisions; the worker resolves each to its tenant via the
	// control-plane domains table. The sso.* hostnames are same-zone tenants resolved
	// the same way (Cloudflare for SaaS metadata does not apply to own-zone hosts).
	// Replace ids/zone as needed before deploy.
	"routes": [
		{ "pattern": "auth.sergiodxa.com", "custom_domain": true },
		{ "pattern": "*.auth.sergiodxa.com/*", "zone_name": "sergiodxa.com" },
		{ "pattern": "sso.sergiodxa.com/*", "zone_name": "sergiodxa.com" },
		{ "pattern": "sso.blog.sergiodxa.com/*", "zone_name": "sergiodxa.com" },
	],

	// `auth-saas-jobs` carries every scheduled job: a cron trigger enqueues the jobs it
	// names and returns, and each one runs on its own delivery. `wrangler queues create
	// auth-saas-jobs` must precede any deploy that references it, or the deploy fails.
	//
	// `max_batch_size` of 1 gives the daily domain-refresh job its own invocation and
	// full wall-clock budget. `max_retries` of 3 covers a transient D1 or Cloudflare API
	// failure; the job is idempotent, so a redelivery repeats work rather than
	// double-counting it. There is no dead-letter queue: the only producer is this
	// worker's own cron, and a message that outlives its retries runs again on the next
	// day's trigger.
	"queues": {
		"consumers": [{ "queue": "auth-saas-jobs", "max_batch_size": 1, "max_retries": 3 }],
		"producers": [{ "binding": "QUEUE", "queue": "auth-saas-jobs" }],
	},

	// Cloudflare Email Sending binding (the only email transport).
	"send_email": [{ "name": "SEND_EMAIL" }],

	"d1_databases": [
		{
			"binding": "PLATFORM_DB",
			"database_name": "auth-saas-platform",
			// Replace with the real D1 id from `wrangler d1 create auth-saas-platform`.
			"database_id": "placeholder-dev-db-id",
			"migrations_dir": "./database/migrations",
		},
	],

	"kv_namespaces": [
		// Caches hostname -> tenant resolution for same-zone hostnames.
		// Replace with the real id from `wrangler kv namespace create HOSTNAMES_KV`.
		{ "binding": "HOSTNAMES_KV", "id": "placeholder-hostnames-kv-id" },
		// Holds the release-flag and kill-switch definition set as one JSON value.
		// Replace with the real id from `wrangler kv namespace create FLAGS`.
		{ "binding": "FLAGS", "id": "placeholder-flags-kv-id" },
		// Counts the mail-sending rate limit class's hour-long window: no rate limiter
		// binding can declare a period longer than 60 seconds.
		// Replace with the real id from `wrangler kv namespace create MAIL_RATE_LIMIT_KV`.
		{ "binding": "MAIL_RATE_LIMIT_KV", "id": "placeholder-mail-rate-limit-kv-id" },
		// Counts the Turnstile challenge trigger over the interactive credential
		// class's own window, tracking the same address so it decays on the same
		// cadence — a `KVAdapter` counter kept apart from that class's own
		// `CloudflareAdapter` budget, since that one reports no remaining count.
		// Replace with the real id from `wrangler kv namespace create TURNSTILE_CHALLENGE_KV`.
		{ "binding": "TURNSTILE_CHALLENGE_KV", "id": "placeholder-turnstile-challenge-kv-id" },
	],

	"r2_buckets": [],

	"ratelimits": [
		{
			// Interactive credential rate limit: 10 requests per 10 seconds per address.
			// Applies to sign-in, sign-up, password reset and the second-factor post.
			"name": "CREDENTIAL_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 10 },
		},
		{
			// Management API rate limit: 100 requests per 60 seconds per client
			// Applies to /api/* endpoints (authenticated by client access token)
			"name": "MANAGEMENT_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 100, "period": 60 },
		},
		{
			// Token endpoint rate limit: 60 requests per 10 seconds per client (or address).
			// Applies to /oauth/token.
			"name": "TOKEN_RATE_LIMITER",
			"namespace_id": "1004",
			"simple": { "limit": 60, "period": 10 },
		},
		{
			// Authorization rate limit: 30 requests per 10 seconds per address.
			// Applies to /authorize.
			"name": "AUTHORIZATION_RATE_LIMITER",
			"namespace_id": "1005",
			"simple": { "limit": 30, "period": 10 },
		},
		{
			// Read-only protocol rate limit: 120 requests per 10 seconds per address.
			// Applies to /.well-known/* and /userinfo.
			"name": "PROTOCOL_RATE_LIMITER",
			"namespace_id": "1006",
			"simple": { "limit": 120, "period": 10 },
		},
	],

	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "auth-saas-analytics",
		},
	],

	"durable_objects": {
		"bindings": [{ "name": "TENANT", "class_name": "Tenant" }],
	},

	"migrations": [{ "tag": "add-tenant-do", "new_sqlite_classes": ["Tenant"] }],

	// Walks the pending-domains index daily, promoting or failing verification attempts.
	// The five-minute expression is the webhook delivery sweep's own backstop cadence:
	// it accelerates deliveries already due, while the delay each delivery's own retry
	// schedules is what actually paces a redelivery.
	"triggers": { "crons": ["0 0 * * *", "*/5 * * * *"] },

	"vars": {
		"PLATFORM_DOMAIN": "auth.sergiodxa.com",
		"EMAIL_FROM": "Auth SaaS <noreply@auth.sergiodxa.com>",
	},
}
