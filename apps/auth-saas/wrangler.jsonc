{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "auth-saas",
	"main": "./src/entry.worker.ts",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,

	"dev": { "port": 3004 },

	"placement": { "mode": "off" },

	"observability": { "enabled": true },

	"assets": { "directory": "./assets", "binding": "ASSETS" },

	"triggers": {
		// Run MAU reporting job daily at 1:00 AM UTC
		"crons": ["0 1 * * *"],
	},

	"queues": { "consumers": [], "producers": [] },

	"d1_databases": [
		{
			"binding": "PLATFORM_DB",
			"database_name": "auth-saas-platform",
			"database_id": "placeholder-dev-db-id",
			"migrations_dir": "./src/app/migrations",
		},
	],

	"kv_namespaces": [],

	"r2_buckets": [],

	"ratelimits": [
		{
			// Auth endpoint rate limit: 10 requests per 10 seconds per IP
			// Applies to /oauth/token, /webauthn/* endpoints
			"binding": "AUTH_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 10 },
		},
		{
			// Strict rate limit for sensitive operations: 5 per minute per IP
			// Applies to password reset, email verification
			"binding": "STRICT_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 },
		},
	],

	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "auth-saas-analytics",
		},
	],

	"durable_objects": {
		"bindings": [{ "name": "TENANT", "class_name": "Tenant" }],
	},

	"migrations": [{ "tag": "add-tenant-do", "new_sqlite_classes": ["Tenant"] }],

	"vars": {
		"PLATFORM_DOMAIN": "auth.sergiodxa.com",
		"EMAIL_FROM": "Auth SaaS <noreply@auth.sergiodxa.com>",
	},
}
