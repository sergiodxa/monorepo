{
	"extends": "../../tsconfig.json",
	"include": [
		"app/**/*",
		"bootstrap/**/*",
		"config/**/*",
		"database/**/*",
		"resources/**/*",
		"routes/**/*",
		"scripts/**/*",
		"vite.config.ts",
		"worker-configuration.d.ts"
	],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "remix/component",
		"noEmit": true,
		"types": [
			"@total-typescript/ts-reset",
			"vite/client",
			"bun",
			"node",
			"@cloudflare/vitest-pool-workers/types"
		],
		// The render middleware pulls in `remix/middleware/render` (beta), whose `dist`
		// is TypeScript source importing siblings with `.ts` extensions; allow it (safe
		// under `noEmit`). Mirrors the sibling `blog-saas` app.
		"allowImportingTsExtensions": true,
		"rootDirs": ["."],
		"paths": {
			"~/app/*": ["./app/*"],
			"~/config/*": ["./config/*"],
			"~/database/*": ["./database/*"],
			"~/resources/*": ["./resources/*"],
			"~/routes/*": ["./routes/*"]
		}
	}
}
