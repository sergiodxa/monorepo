# The Worker's secrets, with values for local development. Copy this file to `.dev.vars`, which
# `bun dev` reads. Set each one for production with `bunx wrangler secret put <NAME>` before the
# first deploy; `docs/first-deploy.md` says where each value comes from.

# OAuth client credentials for auth.sergiodxa.com
CLIENT_ID=
CLIENT_SECRET=

# Secret used to sign session cookies. It also still verifies one-click unsubscribe links
# mailed before they moved to the UNSUBSCRIBE_SECRET Secrets Store binding (wrangler.jsonc).
COOKIE_SESSION_SECRET=

# Billing platform credentials, from the Polar dashboard
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PAID_PRODUCT_ID=
POLAR_PREMIUM_PRODUCT_ID=

# Web Push identity, one P-256 key pair for the whole deployment. The private half is a
# secret; the public half is what a browser subscribes with, and the subject is a `mailto:`
# a push service contacts about a misbehaving sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Where this app answers, and the verified address the email channel sends from
APP_URL=
EMAIL_FROM=

# Key the media proxy signs image addresses with. Rotating it is how a signed address is
# revoked, and there is nothing else to revoke: an address carries no expiry.
MEDIA_PROXY_SECRET=

# Key an agent token is signed under. The token names itself, so this is the whole of
# what turns a signed string back into a reader; rotating it signs out every agent at once.
# The placeholder below is what a fresh copy of this file signs with, so the agent endpoint
# answers on a new checkout and in CI; a deployment holds its own value as a Worker secret.
AGENT_TOKEN_SECRET=local-development-agent-token-secret

# The Web Bot Auth signing key: an Ed25519 private JWK, as JSON. Feed and article requests are
# signed with it, and /.well-known/http-message-signatures-directory publishes its public half.
# Left empty, requests go out unsigned and the directory answers 404.
WEB_BOT_AUTH_KEY=

# The OpenPGP private key /.well-known/security.txt is cleartext-signed with, armored and without
# a passphrase (`gpg --armor --export-secret-keys <fingerprint>`). Left empty, the file is served
# unsigned.
SECURITY_TXT_SIGNING_KEY=

# The https URL of the published OpenPGP public key security.txt names in `Encryption`. Left
# empty, the file has no `Encryption` field.
SECURITY_TXT_ENCRYPTION_URL=
