# Auth (OAuth client for auth.sergiodxa.com)
CLIENT_ID=
CLIENT_SECRET=

# Session
COOKIE_SESSION_SECRET=

# WebSub hub the feeds advertise and the CMS pings (also set in wrangler.jsonc vars)
WEBSUB_HUB=https://pubsubhubbub.appspot.com/

# Inbox Encore support requests are delivered to (a Worker secret in production)
SUPPORT_INBOX=

# Reads the public GitHub Sponsors roster (a Worker secret in production; needs no scopes)
GITHUB_TOKEN=
