{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "blog",
	"main": "./bootstrap/worker.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"dev": {
		"port": 3000,
	},
	"placement": {
		"mode": "smart",
	},
	"observability": {
		"enabled": true,
	},
	// Serves the tagged public pages `app/services/cache.ts` declares, and backs the
	// purge the CMS runs after a write. `cross_version_cache` stays off so entries
	// belong to the version that stored them: a deploy then starts on an empty cache,
	// which makes shipping a fix a way out of a bad page rather than a wait for the
	// lifetime to expire.
	"cache": {
		"enabled": true,
		"cross_version_cache": false,
	},
	"assets": {
		"directory": "./build/client",
	},
	"routes": [{ "pattern": "sergiodxa.com", "custom_domain": true }],
	// The WebSub hub the feeds advertise and the CMS pings after a write. Google's public
	// hub is free, needs no account, accepts the `hub.mode=publish` ping, and is the hub the
	// large feed readers already subscribe through, so a push reaches them without polling.
	"vars": { "WEBSUB_HUB": "https://pubsubhubbub.appspot.com/" },
	"secrets_store_secrets": [
		{
			"binding": "CLIENT_ID",
			"store_id": "e8d9e39c4db6485bbd65a9658e8f9a71",
			"secret_name": "BLOG_CLIENT_ID",
		},
		{
			"binding": "CLIENT_SECRET",
			"store_id": "e8d9e39c4db6485bbd65a9658e8f9a71",
			"secret_name": "BLOG_CLIENT_SECRET",
		},
		{
			"binding": "COOKIE_SESSION_SECRET",
			"store_id": "e8d9e39c4db6485bbd65a9658e8f9a71",
			"secret_name": "COOKIE_SESSION_SECRET",
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "597a3ce0108c42798aeac0044a566e31",
			"preview_id": "597a3ce0108c42798aeac0044a566e31",
		},
		{
			"binding": "AUTH",
			"id": "fda5fdfe90e74e2b82dd0ccd49346c27",
			"preview_id": "fda5fdfe90e74e2b82dd0ccd49346c27",
		},
		{
			"binding": "REDIRECTS",
			"id": "2bcc558cadce40dcb9c73f047c26be6c",
			"preview_id": "2bcc558cadce40dcb9c73f047c26be6c",
		},
	],
	// Caller budget for the public, unauthenticated MCP endpoint (see
	// `app/mcp/rate-limit.ts`). This binding rather than a KV counter because the endpoint
	// bills nothing per call: a KV read plus write per counted request would cost several
	// times the request being protected. `namespace_id` is a Worker-local identifier, not an
	// account resource, so nothing has to be provisioned for it; `period` accepts only 10 or
	// 60. `limit`/`period` are duplicated as constants in that module, which is where the
	// reasoning for the numbers lives — the binding reports neither back.
	"ratelimits": [
		{ "name": "MCP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
		// The Webmention endpoint's budget, spent once per client address and once per source
		// host (`app/http/middleware/webmention-rate-limit.ts`, which mirrors these numbers).
		{
			"name": "WEBMENTION_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 30, "period": 60 },
		},
		// The Encore support form's budget per client address (`app/services/support-desk.ts`,
		// which mirrors the limit). Every submission counts, valid or not.
		{
			"name": "SUPPORT_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 5, "period": 60 },
		},
	],

	// Delivers Encore support requests to the inbox in the `SUPPORT_INBOX` secret, from the
	// sender in `app/services/support-desk.ts`, which has to be a verified sending domain. The
	// bare form allows any verified destination, since the inbox is a secret rather than a
	// value written here. A local run only logs the message it would have sent.
	"send_email": [{ "name": "EMAIL" }],

	// Background jobs (`app/jobs/dispatcher.ts`): Webmention verification and sending.
	// One message per invocation keeps a slow source or endpoint from holding up others.
	"queues": {
		"consumers": [{ "queue": "blog-jobs", "max_batch_size": 1, "max_retries": 5 }],
		"producers": [{ "binding": "QUEUE", "queue": "blog-jobs" }],
	},
	// Every quarter hour, the job map's `webmentions.scheduled` sends the Webmentions of
	// posts whose scheduled publish date has arrived, and every six hours `sponsors.refresh`
	// stores the sponsor roster. Kept equal to the jobs' `cron`, which
	// `app/jobs/dispatcher.test.ts` checks.
	"triggers": { "crons": ["*/15 * * * *", "0 */6 * * *"] },

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "db",
			"database_id": "f6bb2533-9284-4427-83e6-ea12c6630026",
			"migrations_dir": "./database/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BACKUPS",
			"bucket_name": "backups",
			"preview_bucket_name": "backups",
		},
	],
}
