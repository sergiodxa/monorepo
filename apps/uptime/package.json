{
	"name": "@apps/uptime",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"cf:deploy": "bunx wrangler deploy",
		"cf:typegen": "bunx wrangler types",
		"db:local:migrate": "bunx wrangler d1 migrations apply DB --local",
		"db:remote:migrate": "bunx wrangler d1 migrations apply DB --remote",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@sdxc/auth": "workspace:*",
		"@sdxc/billing": "workspace:*",
		"@sdxc/cron": "workspace:*",
		"@sdxc/crypto": "workspace:*",
		"@sdxc/data-table-d1": "workspace:*",
		"@sdxc/dates": "workspace:*",
		"@sdxc/highlight": "workspace:*",
		"@sdxc/http": "workspace:*",
		"@sdxc/i18n": "workspace:*",
		"@sdxc/icons": "workspace:*",
		"@sdxc/jobs": "workspace:*",
		"@sdxc/kv-cache": "workspace:*",
		"@sdxc/location": "workspace:*",
		"@sdxc/logger": "workspace:*",
		"@sdxc/mail": "workspace:*",
		"@sdxc/markdown": "workspace:*",
		"@sdxc/rate-limit": "workspace:*",
		"@sdxc/result": "workspace:*",
		"@sdxc/seo": "workspace:*",
		"@sdxc/service-container": "workspace:*",
		"@sdxc/session-storage-kv": "workspace:*",
		"@sdxc/sitemap": "workspace:*",
		"@sdxc/spec": "workspace:*",
		"@sdxc/strings": "workspace:*",
		"@sdxc/typeid": "workspace:*",
		"@sdxc/u": "workspace:*",
		"@sdxc/ui": "workspace:*",
		"@sdxc/uuid": "workspace:*",
		"@sdxc/validate": "workspace:*",
		"remix": "3.0.0-rc.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.2",
		"@sdxc/cloudflare-mocks": "workspace:*",
		"@sdxc/jwt": "workspace:*",
		"vite": "^8.2.2",
		"wrangler": "^4.127.1"
	}
}
