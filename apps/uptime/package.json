		"@pkg/validate": "workspace:*",
		"@polar-sh/sdk": "^0.48.1",
		"@react-router/fs-routes": "^8.3.0",
		"cron-parser": "^5.6.2",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"fuse.js": "^7.5.0",
		"i18next": "^26.3.6",
		"i18next-browser-languagedetector": "^8.2.1",
