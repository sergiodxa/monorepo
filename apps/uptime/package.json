{
	"name": "@apps/uptime",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "bun run cf:typegen && bun run rr:typegen",
		"build": "vite build",
		"start": "vite preview",
		"precf:deploy": "bun run build",
		"cf:deploy": "wrangler deploy",
		"cf:typegen": "wrangler types",
		"rr:routes": "react-router routes",
		"rr:typegen": "react-router typegen",
		"db:local:drop": "rm -rf ./.wrangler",
		"db:local:migrate": "wrangler d1 migrations apply --local",
		"db:remote:migrate": "wrangler d1 migrations apply --remote",
		"orm:generate": "drizzle-kit generate --config drizzle.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@edgefirst-dev/api-client": "^0.3.0",
