{
	"extends": "../../tsconfig.json",
	"include": [
		"app/**/*",
		"bootstrap/**/*",
		"config/**/*",
		"database/**/*",
		"resources/**/*",
		"routes/**/*",
		"vite.config.ts",
		"worker-configuration.d.ts"
	],
	"compilerOptions": {
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"jsxImportSource": "remix/component",
		"types": [
			"@total-typescript/ts-reset",
			"vite/client",
			"bun",
			"node",
			"@cloudflare/vitest-plugin/types"
		],
		"paths": {
			"~/app/*": ["./app/*"],
			"~/config/*": ["./config/*"],
			"~/database/*": ["./database/*"],
			"~/resources/*": ["./resources/*"],
			"~/routes/*": ["./routes/*"]
		}
	}
}
