# OAuth Client credentials for auth.sergiodxa.com
CLIENT_ID=
CLIENT_SECRET=

# Polar.sh API token for subscription management
POLAR_ACCESS_TOKEN=

# Secret used to verify incoming Polar.sh webhook signatures
POLAR_WEBHOOK_SECRET=

# Resend API token for sending emails
RESEND_API_TOKEN=

# Secret used to sign session cookies
COOKIE_SESSION_SECRET=

# API key for self-monitoring cron job (ping our own cron job monitor)
UPTIME_CRON_API_KEY=

# Cloudflare API token for integrations
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=
