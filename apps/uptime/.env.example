# The Worker's secrets, with values for local development. Copy this file to `.dev.vars`, which
# `bun dev` and `sdxc run typegen` read. Set each one for production with
# `bunx wrangler secret put <NAME>` before the first deploy that reads it.

# OAuth client credentials for auth.sergiodxa.com, which signs every user in.
CLIENT_ID=
CLIENT_SECRET=

# Polar.sh API token for subscription management.
POLAR_ACCESS_TOKEN=

# Verifies incoming Polar.sh webhook signatures; a webhook is refused while it is unset.
POLAR_WEBHOOK_SECRET=

# Signs the session cookie, and keys the try-it form's honeypot. Use a long random value in
# production; changing it signs every visitor out.
COOKIE_SESSION_SECRET=

# API key the job dispatcher reports each finished scheduled run to its cron-job monitor with.
UPTIME_CRON_API_KEY=

# Cloudflare account and token the Analytics Engine queries read through.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=

# Cloudflare Turnstile, which the public try-it form asks a visitor to pass. These are
# Cloudflare's test keys, which render a visible widget that always passes; create a widget in
# the Cloudflare dashboard for the production keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# The Web Bot Auth signing key: an Ed25519 private JWK, as JSON. Every HTTP probe is signed with
# it, and /.well-known/http-message-signatures-directory publishes its public half. Left empty,
# probes go out unsigned and the directory answers 404.
WEB_BOT_AUTH_KEY=

# The OpenPGP private key /.well-known/security.txt is cleartext-signed with, armored and without
# a passphrase (`gpg --armor --export-secret-keys <fingerprint>`). Left empty, the file is served
# unsigned.
SECURITY_TXT_SIGNING_KEY=

# The https URL of the published OpenPGP public key security.txt names in `Encryption`. Left
# empty, the file has no `Encryption` field.
SECURITY_TXT_ENCRYPTION_URL=

# x402 guest probe (`POST /api/v1/guest/probe`). Soft-launch: set
# X402_FACILITATOR_URL to `memory` (or leave empty) so the route runs free until
# a real facilitator + wallet are ready. Non-http stubs (e.g. `test-local`) still
# charge via MemoryFacilitator for local settlement tests. Production: an
# https://… facilitator, Base mainnet network/asset, and your receive address.
# Marketing `/try` stays free and does not read these.
X402_FACILITATOR_URL=memory
X402_PAY_TO=0x00000000000000000000000000000000000000fe
X402_FACILITATOR_AUTH=
X402_NETWORK=eip155:84532
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

