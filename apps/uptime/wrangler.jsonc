{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "ping",
	"main": "./app/entry.worker.ts",
	"compatibility_date": "2025-04-07",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"dev": { "port": 3002 },
	"placement": { "mode": "off" },
	"observability": { "enabled": true },
	"assets": { "directory": "./build/client" },

	"triggers": {
		"crons": [
			"* * * * *", // Every minute - uptime monitors + cron job monitors
			"*/5 * * * *", // Every 5 minutes - TCP monitors
			"*/10 * * * *", // Every 10 minutes - domain verification
			"0 * * * *", // Every hour - DNS monitors
			"0 0 * * *", // Every day at midnight - cleanup
			"0 6 * * *", // Every day at 6 AM UTC - SSL checks
		],
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ping",
			"database_id": "b51fff7c-c4dd-412d-8b56-57da405b780e",
			"preview_database_id": "b51fff7c-c4dd-412d-8b56-57da405b780e",
			"migrations_dir": "./db/migrations",
		},
	],

	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "ea5b4a1bb7804692992b013e1627a8ad",
			"preview_id": "ea5b4a1bb7804692992b013e1627a8ad",
		},
	],

	"queues": {
		"consumers": [{ "queue": "ping" }],
		"producers": [{ "binding": "QUEUE", "queue": "ping" }],
	},

	"durable_objects": {
		"bindings": [{ "name": "GEO_FETCH", "class_name": "GeoFetchDO" }],
	},

	"migrations": [
		{ "tag": "add-ping-do", "new_classes": ["PingDO"] },
		{
			"tag": "rename-ping-do",
			"renamed_classes": [{ "from": "PingDO", "to": "GeoFetchDO" }],
		},
	],

	"workflows": [{ "name": "ping-workflow", "binding": "PING", "class_name": "Ping" }],

	"analytics_engine_datasets": [{ "binding": "PING_RESULTS", "dataset": "ping_results" }],
}
