{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "ping",
	"main": "./bootstrap/worker.ts",
	"compatibility_date": "2026-04-10",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"dev": { "port": 3000 },
	"placement": { "mode": "smart" },
	"observability": { "enabled": true },
	"assets": { "directory": "./build/client" },

	// The every-minute trigger delivers every monitor sweep: HTTP, cron jobs, TCP and DNS.
	// TCP had its own `*/5 * * * *` and DNS its own `0 * * * *` until each one's
	// `interval_seconds` became authoritative (ADR-006), which left those two triggers
	// setting a ceiling on how fine an interval was reachable and nothing else. Each sweep
	// now claims only the monitors that are due, so the finer delivery reads an indexed range
	// that matches nothing in most minutes instead of every enabled row every time.
	"triggers": {
		"crons": [
			"* * * * *", // Every minute - uptime + cron job + TCP + DNS monitors
			"*/10 * * * *", // Every 10 minutes - domain verification
			// Every hour - re-check the URLs left on the public trial page. Its own trigger and
			// not a share of the every-minute one: an hour is the free watch's entire cadence and
			// is fixed by the product, so a finer delivery would spend a queue hop to read an
			// indexed range that matches nothing in fifty-nine minutes out of sixty.
			"0 * * * *",
			"0 0 * * *", // Every day at midnight - cleanup
			"0 1 * * *", // Every day at 1 AM UTC - aggregate daily stats
			"0 2 * * *", // Every day at 2 AM UTC - reconcile Polar subscriptions
			// Every day at 3 AM UTC - report yesterday's per-team infrastructure cost to
			// Polar Cost Insights. Three hours past the UTC day boundary, so any data point
			// written late in the day has certainly landed in Analytics Engine, and on its
			// own hour rather than sharing 01:00 or 02:00 so a failure in the daily roll-up
			// or the subscription reconciliation neither delays nor is delayed by this.
			"0 3 * * *",
			// Every day at 4 AM UTC - erase the accounts queued for deletion. Its own hour rather
			// than sharing 03:00 for the same reason that one has one: it cancels subscriptions in
			// Polar, and a failure in the cost report must neither delay nor be delayed by
			// somebody's erasure. After 02:00 on purpose, so the subscription reconciliation has
			// finished before rows are revoked and cannot re-write a projection for an account
			// being deleted. A queued request is therefore honoured within a day of being made,
			// and that day is the grace period a person can still cancel in.
			"0 4 * * *",
			// Every day at 6 AM UTC - SSL checks, plus the free trial's daily digests. The digest
			// takes the last of the daily triggers because its once-a-day bound is counted from
			// midnight UTC and it must not assemble an email out of rows the midnight cleanup is
			// deleting; six hours is far more than that sweep needs.
			"0 6 * * *",
			// Every day at 7 AM UTC - count yesterday's public-trial funnel, write the day to
			// `trial_daily_stats`, and mail the report. On its own hour rather than sharing 06:00,
			// so a failure in the SSL sweep or the digests neither delays nor is delayed by a
			// report about them. It reads only the previous UTC day, so the midnight cleanup
			// finished seven hours before it starts.
			"0 7 * * *",
			// Every day at 8 AM UTC - mail each team's members the digest of yesterday's monitors.
			// It reports what the 01:00 roll-up wrote, so it has to run after that, and it takes
			// its own hour so a failure in any of the three jobs above cannot delay mail going to
			// paying customers. Last of the daily triggers, which also makes it the most humane
			// hour of the five for something a person reads.
			"0 8 * * *",
			// Mondays at 9 AM UTC - the same digest over the seven days that just ended. An hour
			// after the daily one because on Mondays a member receives both, and the two are
			// separate switches: neither may depend on the other having run.
			"0 9 * * 1",
		],
	},

	"routes": [{ "pattern": "uptime.sergiodxa.com", "custom_domain": true }],

	// Plain secrets (COOKIE_SESSION_SECRET, CLIENT_ID/SECRET, POLAR_ACCESS_TOKEN,
	// POLAR_WEBHOOK_SECRET, UPTIME_CRON_API_KEY,
	// CLOUDFLARE_ACCOUNT_ID/ANALYTICS_TOKEN, TURNSTILE_SITE_KEY/SECRET_KEY,
	// FUNNEL_REPORT_TO) are
	// set via `.dev.vars` locally and `wrangler secret put` in production — same as the
	// OLD APP (`apps/uptime/app/cookies.ts` reads `env.COOKIE_SESSION_SECRET` directly)
	// and `apps/auth-saas`. Not declared here; only bindings need a wrangler.jsonc entry.

	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "ea5b4a1bb7804692992b013e1627a8ad",
			"preview_id": "ea5b4a1bb7804692992b013e1627a8ad",
		},
	],

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ping",
			"database_id": "b51fff7c-c4dd-412d-8b56-57da405b780e",
			"preview_database_id": "b51fff7c-c4dd-412d-8b56-57da405b780e",
			"migrations_dir": "./database/migrations",
		},
	],

	// R2 bucket bindings can be added here when needed
	"r2_buckets": [],

	// Without a `dead_letter_queue` an exhausted message is discarded, and nothing records
	// that a scheduled check was never performed. `CheckHttpJob` only retries infrastructure
	// faults — a monitored endpoint being down is a stored result, not an error — so an
	// exhausted message is always the class worth knowing about, and since scheduling claims
	// a monitor's next due time up front it doesn't come back on the next tick either: the
	// monitor just misses that interval, silently. `max_retries` is stated even though 3 is
	// the default because it and the DLQ are one policy ("three attempts, then dead-letter"),
	// not two settings, so neither half is inherited invisibly.
	//
	// `ping-dlq` needs `wrangler queues create ping-dlq` before any deploy that references
	// it, or the deploy fails. Its consumer records and never retries, which is a property of
	// the handler always acking rather than of a retry setting here. The `DLQ` producer
	// binding is for bodies that fail schema validation: they go straight there instead of
	// spending three redeliveries on a payload no redelivery can fix.
	"queues": {
		"consumers": [
			{ "queue": "ping", "dead_letter_queue": "ping-dlq", "max_retries": 3 },
			{ "queue": "ping-dlq" },
		],
		"producers": [
			{ "binding": "QUEUE", "queue": "ping" },
			{ "binding": "DLQ", "queue": "ping-dlq" },
		],
	},

	"durable_objects": {
		"bindings": [{ "name": "GEO_FETCH", "class_name": "GeoFetchDO" }],
	},

	// Deploying under the `ping` script name inherits its existing DO migration
	// history server-side (add-ping-do -> rename-ping-do already applied to
	// class GeoFetchDO) — listed here unchanged, matching apps/uptime/wrangler.jsonc,
	// so this deploy is a no-op for DO migrations rather than redeclaring the class.
	"migrations": [
		{ "tag": "add-ping-do", "new_classes": ["PingDO"] },
		{
			"tag": "rename-ping-do",
			"renamed_classes": [{ "from": "PingDO", "to": "GeoFetchDO" }],
		},
	],

	// `uptime_costs` is the cost ledger's staging buffer (ADR-007 §6): one data point per
	// team per unit of work, holding measured *quantities* rather than money, so a rate-card
	// correction can be re-applied across the whole retained window. Priced and forwarded to
	// Polar daily, which is the store of record — Analytics Engine keeps three months, so
	// nothing here is an archive. A dataset needs no provisioning; the first write creates it.
	"analytics_engine_datasets": [
		{ "binding": "PING_RESULTS", "dataset": "uptime_monitor_results" },
		{ "binding": "COSTS", "dataset": "uptime_costs" },
	],

	// Caller budget for the public, unauthenticated cron-job ping endpoint (see
	// `app/http/controllers/api/cron-job-ping.ts`). This binding, not KV, because it
	// bills nothing per call: a KV read plus write per counted request would cost
	// several times the request being protected, so the protection would cost more
	// than the abuse. `namespace_id` is a Worker-local identifier, not an account
	// resource, so nothing has to be provisioned for it; `period` accepts only 10 or
	// 60. `limit`/`period` are duplicated as constants in the controller, which is
	// where the reasoning for the numbers lives — the binding reports neither back.
	"ratelimits": [
		{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
		// A far tighter ceiling than RATE_LIMITER's, because the surface is different: the
		// cron ping and the ad-hoc API are authenticated and billed, so a caller running
		// them hard is a caller paying for it, while the public try-it page probes on
		// behalf of a stranger for free. A separate binding rather than a second key prefix
		// because `limit`/`period` are properties of the binding, not of the key.
		//
		// Three a minute: a person trying the tool runs a check, reads the result, and
		// thinks, so one probe a minute would be enough for the happy path — but the budget
		// is spent before the challenge is verified, so a submission the challenge refuses
		// burns an allowance with no check behind it. Three leaves room for those retries
		// and is still hostile to a script. The daily budget bounds the spend; this bounds
		// the rate.
		{
			"name": "TRIAL_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 3, "period": 60 },
		},
	],

	// Platform-native email sending. Every message the app puts in an inbox goes through
	// this binding: `CloudflareTransport` is the transport both mailers are built with, the
	// request-scoped one in `bootstrap/app.tsx` and the background one in
	// `app/lib/container.ts`. Nothing sends over an HTTP API any more, so the binding has to
	// resolve for the worker to mail at all.
	//
	// The account's daily send quota starts conservative and is raised over time from
	// observed sending behaviour and deliverability. Down-alerts are the traffic that would
	// meet that ceiling first, and a refused send is reported as a failure rather than
	// retried, so the quota is worth watching while it is still being earned.
	//
	// Per-message limits the send paths stay well inside: 50 recipients across to/cc/bcc,
	// 16 KB of custom headers combined, a 998-character subject, and 5 MiB total. The trial
	// emails' RFC 8058 unsubscribe headers are the only custom headers sent and are two
	// short lines.
	//
	// The bare `name` form allows any verified sender and any destination, which is the only
	// form that fits: alerts go to whoever a team invited, so the recipient set is the user
	// table and cannot be written down here. The narrower forms (`destination_address`,
	// `allowed_destination_addresses`, `allowed_sender_addresses`) would each turn a normal
	// send into a refusal, and the refusal arrives at send time rather than at deploy time.
	//
	// `remote: true` because the local implementation only logs the message it would have
	// sent, which exercises neither the sender verification, nor the destination limits, nor
	// the identifier the send returns — the three things that actually decide whether a
	// message arrives. Remote means a local send is a real send, so a development run bills
	// and delivers like production; that is the point, and it is also the reason not to put
	// this binding behind a loop while iterating.
	"send_email": [{ "name": "EMAIL", "remote": true }],
}
