sergiodxa.com.	1	IN	AAAA	2606:4700:3030::6815:3af9
sergiodxa.com.	1	IN	AAAA	2606:4700:3037::ac43:a682
sergiodxa.com.	1	IN	NS	dora.ns.cloudflare.com.
sergiodxa.com.	1	IN	NS	will.ns.cloudflare.com.
sergiodxa.com.	1	IN	MX	5 aspmx.l.google.com.
sergiodxa.com.	1	IN	MX	5 alt1.aspmx.l.google.com.
sergiodxa.com.	1	IN	MX	5 alt2.aspmx.l.google.com.
sergiodxa.com.	1	IN	MX	5 alt3.aspmx.l.google.com.
sergiodxa.com.	1	IN	MX	5 alt4.aspmx.l.google.com.
sergiodxa.com.	1	IN	TXT	"google-site-verification=9AkcEK4Ofz3GhKILelFPvJALYzt8KfvX8SqVyqeSL90"
sergiodxa.com.	1	IN	TXT	"keybase-site-verification=eJkDHaBUaRYDAydnz5Bp1e3CrwSx49Xusap6naXQui4"
sergiodxa.com.	1	IN	TXT	"openai-domain-verification=dv-ax3YOD1KBEcq9GiJ2e8AzOPM"
sergiodxa.com.	1	IN	TXT	"pinterest-site-verification=b3e5c6e5ca09fc1efd0d8df3e57753cd"

; An owner written as `@`, which resolves to the zone apex.
@	1	IN	TXT	"v=spf1 include:_spf.google.com ~all"	; synthetic

; A relative owner, resolved against the monitor's own domain. Cloudflare writes
; owners fully qualified, so this line is here for hand-written pastes.
www	1	IN	CNAME	sergiodxa.com.

; --- mail and deliverability ------------------------------------------------

_dmarc.sergiodxa.com.	1	IN	TXT	"v=DMARC1; p=none;"
send.sergiodxa.com.	1	IN	MX	10 feedback-smtp.us-east-1.amazonses.com.
send.sergiodxa.com.	1	IN	TXT	"v=spf1 include:amazonses.com ~all"
send.uptime.sergiodxa.com.	1	IN	MX	10 feedback-smtp.us-east-1.amazonses.com.
send.uptime.sergiodxa.com.	1	IN	TXT	"v=spf1 include:amazonses.com ~all"
cf-bounce.auth.sergiodxa.com.	1	IN	MX	13 route2.mx.cloudflare.net.
cf-bounce.auth.sergiodxa.com.	1	IN	MX	39 route3.mx.cloudflare.net.
cf-bounce.auth.sergiodxa.com.	1	IN	MX	61 route1.mx.cloudflare.net.
cf-bounce.auth.sergiodxa.com.	1	IN	TXT	"v=spf1 include:_spf.mx.cloudflare.net ~all"
cf-bounce.uptime.sergiodxa.com.	1	IN	MX	13 route2.mx.cloudflare.net.
cf-bounce.uptime.sergiodxa.com.	1	IN	MX	39 route3.mx.cloudflare.net.
cf-bounce.uptime.sergiodxa.com.	1	IN	MX	61 route1.mx.cloudflare.net.
cf-bounce.uptime.sergiodxa.com.	1	IN	TXT	"v=spf1 include:_spf.mx.cloudflare.net ~all"
