# Buttondown API key used for the newsletter subscriber API
BUTTONDOWN_API_KEY=

# Buttondown API version pinned onto every request (also set in wrangler.jsonc vars)
BUTTONDOWN_API_VERSION=2024-07-01

# Polar.sh API token for products, checkouts, discounts, and orders
POLAR_ACCESS_TOKEN=

# Polar.sh webhook signing secret used to verify incoming order events
POLAR_WEBHOOK_SECRET=
