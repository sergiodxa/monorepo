# The Worker's secrets, with values for local development. Copy this file to `.dev.vars`,
# which `bun dev` reads. Set each one for production with `cf workers secrets update <NAME>`
# before the first deploy that declares it.

# Buttondown's API key, for the newsletter subscriber API. Left empty, every subscribe fails
# as unauthenticated while the pages still render.
BUTTONDOWN_API_KEY=

# Polar's access token, for products, checkouts, discounts and orders.
POLAR_ACCESS_TOKEN=

# Polar's webhook signing secret, which verifies each incoming order event.
POLAR_WEBHOOK_SECRET=

# Signs the attribution cookie that remembers the campaign a visitor arrived from. Use a long
# random value in production; changing it forgets every visitor's campaign.
COOKIE_SECRET=

# Signs the hour-long download link to the sample chapter's EPUB. Use a long random value in
# production; changing it expires every link already sent.
SAMPLE_LINK_SECRET=
