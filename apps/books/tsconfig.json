{
	"extends": "../../tsconfig.json",
	"include": [
		".react-router/types/**/*",
		"app/**/*",
		"app/**/.server/**/*",
		"app/**/.client/**/*",
		"worker-configuration.d.ts",
		"react-router.config.ts",
		"vite.config.ts"
	],
	"compilerOptions": {
		"noEmit": true,
		"jsx": "react-jsx",
		"types": ["@total-typescript/ts-reset", "vite/client"],
		"baseUrl": ".",
		"rootDirs": [".", "./.react-router/types"],
		"paths": {
			"~/*": ["./app/*"]
		}
	}
}
