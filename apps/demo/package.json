{
	"name": "@apps/demo",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"cf:deploy": "cf deploy --prebuilt",
		"cf:typegen": "cf workers types",
		"typecheck": "tsc --noEmit",
		"db:local:migrate": "cf d1 migrations apply 00000000-0000-4000-8000-000000000000 --dir ./database/migrations --local --persist-to ./.cloudflare/state",
		"db:remote:migrate": "cf d1 migrations apply 00000000-0000-4000-8000-000000000000 --dir ./database/migrations",
		"mcp:inspect": "bunx @mcpjam/inspector@latest"
	},
	"dependencies": {
		"@sdxc/cache": "workspace:*",
		"@sdxc/captcha": "workspace:*",
		"@sdxc/data-table-d1": "workspace:*",
		"@sdxc/get-client-ip": "workspace:*",
		"@sdxc/http": "workspace:*",
		"@sdxc/i18n": "workspace:*",
		"@sdxc/jobs": "workspace:*",
		"@sdxc/json-schema": "workspace:*",
		"@sdxc/logger": "workspace:*",
		"@sdxc/mail": "workspace:*",
		"@sdxc/markdown": "workspace:*",
		"@sdxc/mcp": "workspace:*",
		"@sdxc/rate-limit": "workspace:*",
		"@sdxc/result": "workspace:*",
		"@sdxc/typeid": "workspace:*",
		"@sdxc/u": "workspace:*",
		"@sdxc/ui": "workspace:*",
		"@sdxc/uuid": "workspace:*",
		"@sdxc/validate": "workspace:*",
		"remix": "3.0.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
		"@sdxc/cloudflare-mocks": "workspace:*",
		"@sdxc/messageformat": "workspace:*",
		"cf": "1.0.0-beta.5",
		"vite": "^8.2.2"
	}
}
