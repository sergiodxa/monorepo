# The Worker's secrets, with values for local development. Copy this file to `.dev.vars`,
# which `bun dev` reads. The board runs from a laptop and is never deployed, so both stay
# optional.

# Cloudflare Turnstile secret for the captcha the board verifies with. Cloudflare publishes
# an "always passes" test secret, `1x0000000000000000000000000000000AA`, which runs the real
# challenge without an account; leaving this unset falls back to the local word challenge.
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key rendered into the submit form alongside the secret above.
# The matching visible test key is `1x00000000000000000000AA`.
TURNSTILE_SITE_KEY=
