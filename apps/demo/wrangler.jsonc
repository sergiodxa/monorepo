{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "demo",
	"main": "./bootstrap/worker.ts",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"dev": { "port": 3008 },
	"observability": { "enabled": true },
	"assets": { "directory": "./build/client" },

	// The board's postings, read by the list, the MCP tools and the expiry sweep.
	// `bun run db:local:migrate` applies `database/migrations/` to the local copy, which is
	// the only copy this app has: it runs from a laptop and answers no traffic anywhere else.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "demo",
			"database_id": "00000000-0000-4000-8000-000000000000",
			"migrations_dir": "./database/migrations",
		},
	],

	// Expires postings older than thirty days. The trigger enqueues the job and returns, so
	// the sweep runs through the same dispatcher, logging and retries an enqueued job gets.
	"triggers": { "crons": ["0 3 * * *"] },
}
